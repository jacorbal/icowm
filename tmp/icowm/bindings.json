{
    "modifiers": {
        "modc": "Control",
        "mods": "Shift",
        "modl": "Caps_Lock",
        "mod1": "Alt",
        "mod2": "Num_Lock",
        "mod3": "",
        "mod4": "Super",
        "mod5": "Hyper"
    },
    "keyboard": {
        "terminal": "modc+mod1+Return",
        "launcher": "modc+mod1+r",
        "center": "modc+mod1+g",
        "maximize": "modc+mod1+m",
        "shade": "modc+mod1+s",
        "pin": "modc+mod1+p",
        "iconify": "modc+mod1+i",
        "close": "modc+mod1+c",
        "kill": "modc+mod1+mods+Escape",
        "info": "modc+mod1+mods+i",
        "cycle-prev": "mod1+mods+Tab",
        "cycle-next": "mod1+Tab",
        "move": {
            "relative": {
                "right": "modc+mod1+l",
                "left": "modc+mod1+h",
                "up": "modc+mod1+k",
                "down": "modc+mod1+j"
            },
            "absolute": {
                "top-left": "modc+mod1+y",
                "top-right": "modc+mod1+u",
                "bottom-left": "modc+mod1+b",
                "bottom-right": "modc+mod1+n"
            }
        },
        "resize": {
            "right": "modc+mod1+mods+l",
            "left": "modc+mod1+mods+h",
            "up": "modc+mod1+mods+k",
            "down": "modc+mod1+mods+j"
        },
        "desktop": {
            "cycle_prev": "modc+mod1+Left",
            "cycle_next": "modc+mod1+Right"
        },
        "mouse": {
            "move": "button1",
            "resize": "button2",
            "lower": "button3",
            "desktop": {
                "cycle_prev": "button4",
                "cycle_next": "button5"
            }
        }
    }
}
