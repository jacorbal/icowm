{
    "rules": [
    {
        "when": "map",
            "match": {
                "title": [ "About *" ],
                "transient": true
            },
            "apply": {
                "position": "center"
            }
    },
    {
        "when": "both",
        "match": {
            "class": [ "Conky" ],
            "role": [ "desktop-widget" ],
            "type": [ "utility" ]
        },
        "apply": {
            "monitor": 0,
            "sticky": true,
            "focus": false,
            "layer": "below",
            "opacity": { "active": 90, "inactive": 60 },
            "position": { "x": 20, "y": 20 },
            "size": { "width": 200, "height": 100 }
        }
    },
    {
        "when": "map",
        "match": {
            "instance": [ "gmrun" ]
        },
        "apply": {
            "decorated": false,
            "pinned": true,
            "layer": "above",
            "opacity": 90,
            "position": "center"
        }
    },
    {
        "when": "map",
        "match": {
            "class": [ "mpv", "MPlayer", "Vlc" ]
        },
        "apply": {
            "decorated": false,
            "pinned": false,
            "position": "center"
        }
    },
    {
        "when": "map",
        "match": {
            "class": [ "firefox-esr", "Chromium" ]
        },
        "apply": {
            "iconified": false,
            "maximized": true
        }
    },
    {
        "when": "property",
        "match": {
            "class": [ "Steam" ],
            "type": [ "normal" ],
            "transient": false
        },
        "apply": {
            "desktop": 1,
            "sticky": false,
            "iconified": false,
            "fullscreen": true
        }
    }
    ]
}
