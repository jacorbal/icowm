{
    "rules": [
    {
        "when": "map",
            "match": {
                "title": [ "About *" ]
            },
            "apply": {
                "position": "center"
            }
    },
    {
        "when": "map",
        "match": {
            "instance": [ "gmrun" ]
        },
        "apply": {
            "decorated": false,
            "pinned": true,
            "layer": "above",
            "opacity": 90,
            "position": "center"
        }
    },
    {
        "when": "map",
        "match": {
            "title": [ "*mpv", "*mplayer", "*VLC media player" ]
        },
        "apply": {
            "decorated": false,
            "pinned": false,
            "position": "center"
        }
    },
    {
        "when": "map",
        "match": {
            "class": [ "Firefox", "Chromium" ]
        },
        "apply": {
            "maximized": true
        }
    }
    ]
}
