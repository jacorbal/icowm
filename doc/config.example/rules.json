{
    "rules": [
    {
        "when": "property",
        "match": {
            "class": "Xconsole"
        },
        "apply": {
            "desktop": 2,
            "focus": true,
            "layer": "above"
        }
    },
    {
        "when": "map",
        "match": {
            "title": "*Sonata"
        },
        "apply": {
            "sticky": true,
            "decorated": false,
            "layer": "below",
            "position": {
                "x": 1460,
                "y": 10
            }
        }
    },
    {
        "when": "map",
        "match": {
            "title": "gmrun"
        },
        "apply": {
            "sticky": true,
            "decorated": false,
            "layer": "above",
            "position": {
                "x": 710,
                "y": 503
            }
        }
    }
    ]
}
