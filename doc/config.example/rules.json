{
    "rules": [
    {
        "when": "map",
        "match": {
            "type": "splash"
        },
        "apply": {
            "layer": "above",
            "position": "center"
        }
    },
    {
        "when": "map",
        "match": {
            "title": [ "*Sonata*" ],
            "type": "normal"
        },
        "apply": {
            "sticky": true,
            "decorated": false,
            "layer": "below",
            "position": {
                "x": 1460,
                "y": 10
            }
        }
    },
    {
        "when": "map",
        "match": {
            "title": [ "gmrun" ]
        },
        "apply": {
            "sticky": true,
            "decorated": false,
            "layer": "above",
            "position": "center"
        }
    },
    {
        "when": "map",
        "match": {
            "title": [ "*mplayer", "*mpv", "*VLC media player" ]
        },
        "apply": {
            "sticky": false,
            "decorated": false,
            "position": "center"
        }
    }
    ]
}
