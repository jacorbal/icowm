{
    "rules": [
    {
        "when": "map",
        "match": {
            "type": "splash"
        },
        "apply": {
            "layer": "above",
            "position": "center"
        }
    },
    {
        "when": "map",
        "match": {
            "title": [ "*Sonata", "\\[Sonata\\]" ],
            "type": "normal"
        },
        "apply": {
            "decorated": false,
            "pinned": true,
            "layer": "below",
            "opacity": {
                "active": 100,
                "inactive": 75
            },
            "position": {
                "x": 1455,
                "y": 10
            }
        }
    },
    {
        "when": "map",
        "match": {
            "title": [ "gmrun" ]
        },
        "apply": {
            "decorated": false,
            "pinned": true,
            "layer": "above",
            "opacity": 90,
            "position": "center"
        }
    },
    {
        "when": "map",
        "match": {
            "title": [ "*mpv", "*mplayer", "*VLC media player" ]
        },
        "apply": {
            "decorated": false,
            "pinned": false,
            "position": "center"
        }
    }
    ]
}
