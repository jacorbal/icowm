{
    "theme": "default",
    "screens": {
        "count": 1,
        "settings": {
            "desktops": [
            {
                "count": 4,
                "inaugural": 0,
                "settings": [
                { "name": "Desktop 0", "background-color": "#4c5b6b" },
                { "name": "Desktop 1", "background-color": "#8a8f94" },
                { "name": "Desktop 2", "background-color": "#6a5470" },
                { "name": "Desktop 3", "background-color": "#5a7d6f" }
                ]
            },
            {
                "count": 1,
                "inaugural": 0,
                "settings": [
                {
                    "name": "Number Zero",
                    "background-color": "#c0c0c0"
                }
                ]
            }
            ]
        }
    },
    "programs": {
        "terminal": "xterm",
        "launcher": "gmrun",
        "editor": "gvim",
        "file-manager": "pcmanfm",
        "web-browser": "firefox"
    },
    "windows": {
        "gravity": "north-west",
        "show-geom": true,
        "move-step": 10,
        "snap": 4,
        "focus": {
            "policy": "click",
            "is-new-focused": true,
            "is-raised-on-focus": false
        },
        "placement": {
            "policy": "smart",
            "group-related": true
        }
    },
    "icons": {
        "show-geom": false,
        "placement": {
            "policy": "smart"
        }
    },
    "menus": {
        "root": {
            "position": "under-mouse"
        },
        "windows": {
            "position": "under-mouse"
        }
    },
    "systray": {
        "is-enabled": true,
        "position": "top-right",
        "order": "left-to-right",
        "clock": {
            "is-enabled": true,
            "format": "%F %R",
            "position": "right"
        }
    },
    "xsettings": {
        "is-enabled": false,
        "gtk-theme-name": "Adwaita",
        "icon-theme-name": "Adwaita",
        "cursor-theme-name": "Adwaita",
        "cursor-theme-size": 24,
        "dpi": 96
    },
    "show-desktop-notify": true,
    "enable-emergency-shortcut": true
}
