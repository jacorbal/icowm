{
    "theme": "default",

    "topology": {
        "screens": {
            "count": 1,
            "desktops": [
            {
                "count": 4,
                "inaugural": 0,
                "settings": [
                    { "background-color": "#5f7187", "name": "Desktop 0" },
                    { "background-color": "#85648d", "name": "Desktop 1" },
                    { "background-color": "#4d767d", "name": "Desktop 2" },
                    { "background-color": "#936459", "name": "Desktop 3" },
                    { "background-color": "#547768", "name": "Desktop 4" }
                ]
            }
            ]
        }
    },

    "desktops": {
        "cycle": true,
        "warp": true,
        "margins": {
            "top": 0,
            "right": 0,
            "bottom": 0,
            "left": 0
        }
    },

    "windows": {
        "focus": {
            "is-new-focused": true,
            "is-raised-on-focus": false,
            "policy": "click"
        },
        "gravity": "north-west",
        "move-step": 10,
        "placement": {
            "group-related": true,
            "policy": "smart"
        },
        "show-geom": true,
        "snap": 4
    },
    "icons": {
        "placement": {
            "policy": "smart"
        },
        "show-geom": false
    },
    "menus": {
        "root": {
            "position": "under-mouse"
        },
        "windows": {
            "position": "under-mouse"
        }
    },

    "programs": {
        "editor": "gvim",
        "file-manager": "pcmanfm",
        "launcher": "gmrun",
        "terminal": "xterm",
        "web-browser": "firefox"
    },

    "systray": {
        "battery": {
            "backend": {
                "number": 0,
                "type": "acpi"
            },
            "is-enabled": false,
            "poll-seconds": 30,
            "threshold": {
                "charged": 100,
                "critical": 5,
                "low": 20
            }
        },
        "clock": {
            "format": "%a %R",
            "is-enabled": true
        },
        "is-enabled": true,
        "layer": "below",
        "order": "left-to-right",
        "position": "top-left",
        "text": {
            "order": [
                "clock",
            "battery"
            ],
            "position": "left"
        }
    },

    "show-desktop-overlay": true,
    "startup-notification": {
        "timeout-seconds": 15
    },

    "enable-emergency-shortcut": false,
    "enable-fortune-shortcut": true
}
