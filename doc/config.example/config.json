{
    "theme": "default",

    "topology": {
        "screens": {
            "count": 1,
            "desktops": [
            {
                "count": 4,
                "inaugural": 0,
                "layout": {
                    "orientation": "horizontal",
                    "corner": "top-left",
                    "rows": 1,
                    "columns": 4
                },
                "viewport": {
                    "rows": 1,
                    "columns": 1
                },
                "settings": [
                    { "-background-color": "#5f7187", "name": "Desktop 0" },
                    { "background-color": "#85648d", "name": "Desktop 1" },
                    { "background-color": "#4d767d", "name": "Desktop 2" },
                    { "background-color": "#936459", "name": "Desktop 3" },
                    { "background-color": "#547768", "name": "Desktop 4" },
                    { "background-color": "#6b7448", "name": "Desktop 5" }
                ]
            }
            ]
        }
    },

    "desktops": {
        "warp-on-edge-drag": true,
        "wrap-at-bounds": true,
        "margins": { "left": 0, "top": 0, "right": 0, "bottom": 0 }
    },

    "viewport": {
        "pan-icons": true,
        "pan-on-edge-drag": true,
        "pan-on-edge-hover": true,
        "pan-step": 40,
        "mesh": {
            "is-enabled": true,
            "spacing": { "horizontal": 64, "vertical": 64 },
            "thickness": 3,
            "tone-shift": 20
        }
    },

    "overlay": {
        "on-desktop-switch": true,
        "on-viewport-move": true
    },

    "urgency": {
        "notify-activity": true
    },

    "programs": {
        "editor": "gvim",
        "file-manager": "pcmanfm",
        "launcher": "gmrun",
        "terminal": "xterm",
        "web-browser": "firefox"
    },

    "prompt": {
        "is-enabled": true
    },

    "windows": {
        "gravity": "north-west",
        "move-step": 10,
        "show-geom": true,
        "solid-drag": true,
        "edges": {
            "snap": {
                "window": 6,
                "screen": 6
            },
            "resistance": 20
        },
        "focus": {
            "delay-ms": 250,
            "raise": false,
            "focus-new": true,
            "policy": "click"
        },
        "placement": {
            "group-related": false,
            "monitor": "pointer",
            "policy": "smart"
        }
    },

    "icons": {
        "show-geom": false,
        "placement": {
            "policy": "smart"
        }
    },

    "menus": {
        "root": {
            "position": "under-mouse"
        },
        "windows": {
            "position": "under-mouse"
        }
    },

    "systray": {
        "is-enabled": true,
        "layer": "below",
        "order": "left-to-right",
        "avoid-overlap": true,
        "reserve-space": false,
        "margins": { "left": 0, "top": 0, "right": 0, "bottom": 0 },
        "battery": {
            "is-enabled": false,
            "poll-seconds": 30,
            "backend": {
                "number": 0,
                "type": "acpi"
            },
            "threshold": {
                "charged": 100,
                "critical": 5,
                "low": 20
            }
        },
        "clock": {
            "is-enabled": true,
            "format": "%a %R"
        },
        "position": "top-left",
        "text": {
            "order": [ "clock", "battery" ],
            "position": "left"
        }
    },

    "scratchpad": {
        "is-enabled": true,
        "command": "xterm -fg black -bg ivory -cr black",
        "edge": "top",
        "ignore-margins": false,
        "width": "max",
        "height": 300
    },

    "fortune": {
        "is-enabled": true,
        "command": "fortune"
    },

    "startup-notification": {
        "timeout-seconds": 15
    },

    "shutdown": {
        "enable-emergency-shortcut": false,
        "timeout-seconds": 15
    }
}
