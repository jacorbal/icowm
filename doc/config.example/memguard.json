{
    "theme": "default",

    "programs": {
        "editor": "gvim",
        "file-manager": "pcmanfm",
        "launcher": "gmrun",
        "terminal": "xterm",
        "web-browser": "firefox"
    },

    "prompt": {
        "is-enabled": true
    },

    "desktops": {
        "margins": { "left": 0, "top": 0, "right": 0, "bottom": 0 }
    },

    "windows": {
        "gravity": "north-west",
        "move-step": 10,
        "show-geom": true,
        "edges": {
            "snap": {
                "window": 6,
                "screen": 6
            },
            "resistance": 20
        },
        "focus": {
            "focus-new": true,
            "raise": false,
            "policy": "click"
        },
        "placement": {
            "group-related": true,
            "monitor": "pointer",
            "policy": "smart"
        }
    },

    "icons": {
        "show-geom": false,
        "placement": {
            "policy": "smart"
        }
    },

    "systray": {
        "is-enabled": true,
        "layer": "below",
        "battery": {
            "is-enabled": false,
            "poll-seconds": 30,
            "backend": {
                "number": 0,
                "type": "acpi"
            }
        },
        "clock": {
            "is-enabled": true,
            "format": "%a %R"
        },
        "position": "top-right",
        "text": {
            "order": [ "clock", "battery" ]
        },
        "reserve-space": false,
        "margins": { "left": 0, "top": 0, "right": 0, "bottom": 0 }
    },

    "shutdown": {
        "enable-emergency-shortcut": true,
        "timeout-seconds": 15
    }
}
