{
    "name": "Modus Operandi Tinted",

    "-author": "J. A. Corbal",
    "-creation-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-modified-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-notes": "Protesilaos Stavrou's Modus Operandi Tinted, official palette values, with the warmer off-white and off-black canvases of the tinted variants.  Text Lc 68 and 11.1:1 or better, dimmed elements Lc 62, window frames 6.6:1 on the desktop.",

    "desktop": {
        "color": {
            "background": "#fbf7f0"
        }
    },

    "cycle": {
        "border": {
            "color": "#0000ff",
            "width": 4
        }
    },

    "window": {
        "is-decorated": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#000000",
                "width": 2
            },
            "color": {
                "background": "#cab9b2",
                "foreground": "#000000"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "border": {
                "color": "#595959",
                "width": 2
            },
            "color": {
                "background": "#dfd9cf",
                "foreground": "#000000"
            },
            "font": "fixed"
        },
        "titlebar": {
            "alignment": "center",
            "buttons": {
                "color": {
                    "off": "#595959",
                    "on": "#000000"
                },
                "left": [ "pin", "layer" ],
                "right": [ "close", "maximize", "shade", "iconize" ]
            },
            "height": 22,
            "padding": {
                "horizontal": 2,
                "vertical": 2
            }
        }
    },

    "icon": {
        "is-captioned": true,
        "show-hints": true,
        "show-pixmaps": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#000000",
                "width": 1
            },
            "color": {
                "background": "#cab9b2",
                "foreground": "#000000"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "opacity": 100,
            "border": {
                "color": "#595959",
                "width": 1
            },
            "color": {
                "background": "#dfd9cf",
                "foreground": "#000000"
            },
            "font": "fixed"
        }
    },

    "menu": {
        "opacity": 100,
        "show-pixmaps": true,
        "border": {
            "color": "#595959",
            "width": 2
        },
        "disabled": {
            "color": {
                "foreground": "#595959"
            }
        },
        "label": {
            "border": {
                "color": "#595959",
                "width": 0
            },
            "color": {
                "background": "#efe9dd",
                "foreground": "#000000"
            },
            "font": "fixed"
        },
        "padding": {
            "horizontal": 12,
            "vertical": 4
        },
        "selected": {
            "border": {
                "color": "#000000",
                "width": 0
            },
            "color": {
                "background": "#cab9b2",
                "foreground": "#000000"
            },
            "font": "fixed"
        },
        "separator": {
            "color": "#595959"
        },
        "unselected": {
            "border": {
                "color": "#595959",
                "width": 0
            },
            "color": {
                "background": "#dfd9cf",
                "foreground": "#000000"
            },
            "font": "fixed"
        }
    },

    "dialog": {
        "opacity": 100,
        "border": {
            "color": "#595959",
            "width": 2
        },
        "button": {
            "gap": 24,
            "padding": {
                "horizontal": 12,
                "vertical": 6
            },
            "selected": {
                "border": {
                    "color": "#000000",
                    "width": 1
                },
                "color": {
                    "background": "#cab9b2",
                    "foreground": "#000000"
                },
                "font": "fixed bold"
            },
            "unselected": {
                "border": {
                    "color": "#595959",
                    "width": 1
                },
                "color": {
                    "background": "#dfd9cf",
                    "foreground": "#000000"
                },
                "font": "fixed"
            }
        },
        "color": {
            "background": "#dfd9cf"
        },
        "label": {
            "color": {
                "foreground": "#000000"
            },
            "font": "fixed bold",
            "padding": {
                "horizontal": 12,
                "vertical": 12
            }
        }
    },

    "overlay": {
        "opacity": 100,
        "font": "fixed",
        "border": {
            "color": "#595959",
            "width": 1
        },
        "color": {
            "background": "#dfd9cf",
            "foreground": "#000000"
        }
    },

    "systray": {
        "opacity": 100,
        "font": "fixed bold",
        "height": 22,
        "border": {
            "color": "#595959",
            "width": 1
        },
        "color": {
            "background": "#dfd9cf",
            "foreground": "#000000"
        },
        "pixmap": {
            "size": 24,
            "padding": 2
        },
        "text": {
            "gap": 12,
            "valign": "center"
        }
    },

    "search": {
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#cab9b2",
                "foreground": "#000000"
            }
        },
        "selected": {
            "font": "fixed",
            "color": {
                "background": "#cab9b2",
                "foreground": "#000000"
            }
        },
        "unselected": {
            "font": "fixed",
            "color": {
                "background": "#dfd9cf",
                "foreground": "#000000"
            }
        },
        "border": {
            "color": "#595959",
            "width": 2
        }
    },

    "prompt": {
        "label": {
            "font": "fixed bold",
            "color": {
                "background": "#cab9b2",
                "foreground": "#000000"
            }
        },
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#dfd9cf",
                "foreground": "#000000"
            }
        },
        "border": {
            "color": "#595959",
            "width": 2
        }
    },

    "scratchpad": {
        "border": {
            "color": "#000000",
            "width": 2
        }
    },

    "xsettings": {
        "dpi": 96,
        "is-enabled": false,
        "theme": {
            "gtk-theme-name": "Adwaita",
            "icon-theme-name": "Adwaita",
            "cursor-theme-name": "Adwaita",
            "cursor-theme-size": 24
        }
    }
}
