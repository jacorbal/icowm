{
    "name": "Modus Vivendi",

    "-author": "J. A. Corbal",
    "-creation-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-modified-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-notes": "Protesilaos Stavrou's Modus Vivendi, official palette values; the pure black and white canvas is the author's own choice.  Text Lc 93 and 8.1:1 or better, dimmed elements Lc 41, window frames 3.0:1 on the desktop.",

    "desktop": {
        "color": {
            "background": "#000000"
        }
    },

    "cycle": {
        "border": {
            "color": "#00bcff",
            "width": 4
        }
    },

    "window": {
        "is-decorated": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#ffffff",
                "width": 2
            },
            "color": {
                "background": "#505050",
                "foreground": "#ffffff"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "border": {
                "color": "#5a5a5a",
                "width": 2
            },
            "color": {
                "background": "#2d2d2d",
                "foreground": "#ffffff"
            },
            "font": "fixed"
        },
        "titlebar": {
            "alignment": "center",
            "buttons": {
                "size": 12,
                "use-symbols": true,
                "color": {
                    "off": "#959595",
                    "on": "#ffffff"
                },
                "left": [ "sticky", "pin" ],
                "right": [ "close", "maximize", "shade", "iconize" ]
            },
            "height": 22,
            "padding": {
                "horizontal": 2,
                "vertical": 2
            }
        }
    },

    "icon": {
        "is-captioned": true,
        "show-hints": true,
        "show-pixmaps": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#ffffff",
                "width": 1
            },
            "color": {
                "background": "#505050",
                "foreground": "#ffffff"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "opacity": 100,
            "border": {
                "color": "#5a5a5a",
                "width": 1
            },
            "color": {
                "background": "#2d2d2d",
                "foreground": "#ffffff"
            },
            "font": "fixed"
        }
    },

    "menu": {
        "opacity": 100,
        "show-pixmaps": true,
        "border": {
            "color": "#959595",
            "width": 2
        },
        "disabled": {
            "color": {
                "foreground": "#959595"
            }
        },
        "label": {
            "border": {
                "color": "#959595",
                "width": 0
            },
            "color": {
                "background": "#1e1e1e",
                "foreground": "#ffffff"
            },
            "font": "fixed"
        },
        "padding": {
            "horizontal": 12,
            "vertical": 4
        },
        "selected": {
            "border": {
                "color": "#ffffff",
                "width": 0
            },
            "color": {
                "background": "#505050",
                "foreground": "#ffffff"
            },
            "font": "fixed"
        },
        "separator": {
            "color": "#959595"
        },
        "unselected": {
            "border": {
                "color": "#959595",
                "width": 0
            },
            "color": {
                "background": "#2d2d2d",
                "foreground": "#ffffff"
            },
            "font": "fixed"
        }
    },

    "dialog": {
        "opacity": 100,
        "border": {
            "color": "#959595",
            "width": 2
        },
        "button": {
            "gap": 24,
            "padding": {
                "horizontal": 12,
                "vertical": 6
            },
            "selected": {
                "border": {
                    "color": "#ffffff",
                    "width": 1
                },
                "color": {
                    "background": "#505050",
                    "foreground": "#ffffff"
                },
                "font": "fixed bold"
            },
            "unselected": {
                "border": {
                    "color": "#959595",
                    "width": 1
                },
                "color": {
                    "background": "#2d2d2d",
                    "foreground": "#ffffff"
                },
                "font": "fixed"
            }
        },
        "color": {
            "background": "#2d2d2d"
        },
        "label": {
            "color": {
                "foreground": "#ffffff"
            },
            "font": "fixed bold",
            "padding": {
                "horizontal": 12,
                "vertical": 12
            }
        }
    },

    "overlay": {
        "opacity": 100,
        "font": "fixed",
        "border": {
            "color": "#959595",
            "width": 1
        },
        "color": {
            "background": "#2d2d2d",
            "foreground": "#ffffff"
        }
    },

    "systray": {
        "opacity": 100,
        "font": "fixed bold",
        "height": 22,
        "border": {
            "color": "#959595",
            "width": 1
        },
        "color": {
            "background": "#2d2d2d",
            "foreground": "#ffffff"
        },
        "pixmap": {
            "size": 24,
            "padding": 2
        },
        "text": {
            "gap": 12,
            "valign": "center"
        }
    },

    "search": {
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#505050",
                "foreground": "#ffffff"
            }
        },
        "selected": {
            "font": "fixed",
            "color": {
                "background": "#505050",
                "foreground": "#ffffff"
            }
        },
        "unselected": {
            "font": "fixed",
            "color": {
                "background": "#2d2d2d",
                "foreground": "#ffffff"
            }
        },
        "border": {
            "color": "#959595",
            "width": 2
        }
    },

    "prompt": {
        "label": {
            "font": "fixed bold",
            "color": {
                "background": "#505050",
                "foreground": "#ffffff"
            }
        },
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#2d2d2d",
                "foreground": "#ffffff"
            }
        },
        "border": {
            "color": "#959595",
            "width": 2
        }
    },

    "scratchpad": {
        "border": {
            "color": "#ffffff",
            "width": 2
        }
    },

    "xsettings": {
        "dpi": 96,
        "is-enabled": false,
        "theme": {
            "gtk-theme-name": "Adwaita",
            "icon-theme-name": "Adwaita",
            "cursor-theme-name": "Adwaita",
            "cursor-theme-size": 24
        }
    }
}
