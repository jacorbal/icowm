{
    "name": "Breeze (light)",

    "-author": "J. A. Corbal",
    "-creation-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-modified-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-notes": "KDE's Breeze colour scheme, light variant, values from the shipped scheme file.  Text Lc 53 and 6.7:1 or better, dimmed elements Lc 53, window frames 3.7:1 on the desktop.",

    "desktop": {
        "color": {
            "background": "#eff0f1"
        }
    },

    "cycle": {
        "border": {
            "color": "#c65c00",
            "width": 4
        }
    },

    "window": {
        "is-decorated": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#1b1e20",
                "width": 2
            },
            "color": {
                "background": "#3daee9",
                "foreground": "#1b1e20"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "border": {
                "color": "#707d8a",
                "width": 2
            },
            "color": {
                "background": "#fcfcfc",
                "foreground": "#1b1e20"
            },
            "font": "fixed"
        },
        "titlebar": {
            "alignment": "center",
            "buttons": {
                "color": {
                    "off": "#706f6e",
                    "on": "#1b1e20"
                },
                "left": [ "pin", "layer" ],
                "right": [ "close", "maximize", "shade", "iconize" ]
            },
            "height": 22,
            "padding": {
                "horizontal": 2,
                "vertical": 2
            }
        }
    },

    "icon": {
        "is-captioned": true,
        "show-hints": true,
        "show-pixmaps": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#1b1e20",
                "width": 1
            },
            "color": {
                "background": "#3daee9",
                "foreground": "#1b1e20"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "opacity": 100,
            "border": {
                "color": "#707d8a",
                "width": 1
            },
            "color": {
                "background": "#fcfcfc",
                "foreground": "#1b1e20"
            },
            "font": "fixed"
        }
    },

    "menu": {
        "opacity": 100,
        "show-pixmaps": true,
        "border": {
            "color": "#707d8a",
            "width": 2
        },
        "disabled": {
            "color": {
                "foreground": "#383838"
            }
        },
        "label": {
            "border": {
                "color": "#707d8a",
                "width": 0
            },
            "color": {
                "background": "#e3e5e7",
                "foreground": "#1b1e20"
            },
            "font": "fixed"
        },
        "padding": {
            "horizontal": 12,
            "vertical": 4
        },
        "selected": {
            "border": {
                "color": "#1b1e20",
                "width": 0
            },
            "color": {
                "background": "#3daee9",
                "foreground": "#1b1e20"
            },
            "font": "fixed"
        },
        "separator": {
            "color": "#707d8a"
        },
        "unselected": {
            "border": {
                "color": "#707d8a",
                "width": 0
            },
            "color": {
                "background": "#fcfcfc",
                "foreground": "#1b1e20"
            },
            "font": "fixed"
        }
    },

    "dialog": {
        "opacity": 100,
        "border": {
            "color": "#707d8a",
            "width": 2
        },
        "button": {
            "gap": 24,
            "padding": {
                "horizontal": 12,
                "vertical": 6
            },
            "selected": {
                "border": {
                    "color": "#1b1e20",
                    "width": 1
                },
                "color": {
                    "background": "#3daee9",
                    "foreground": "#1b1e20"
                },
                "font": "fixed bold"
            },
            "unselected": {
                "border": {
                    "color": "#707d8a",
                    "width": 1
                },
                "color": {
                    "background": "#fcfcfc",
                    "foreground": "#1b1e20"
                },
                "font": "fixed"
            }
        },
        "color": {
            "background": "#fcfcfc"
        },
        "label": {
            "color": {
                "foreground": "#1b1e20"
            },
            "font": "fixed bold",
            "padding": {
                "horizontal": 12,
                "vertical": 12
            }
        }
    },

    "overlay": {
        "opacity": 100,
        "font": "fixed",
        "border": {
            "color": "#707d8a",
            "width": 1
        },
        "color": {
            "background": "#fcfcfc",
            "foreground": "#1b1e20"
        }
    },

    "systray": {
        "opacity": 100,
        "font": "fixed bold",
        "height": 22,
        "border": {
            "color": "#707d8a",
            "width": 1
        },
        "color": {
            "background": "#fcfcfc",
            "foreground": "#1b1e20"
        },
        "pixmap": {
            "size": 24,
            "padding": 2
        },
        "text": {
            "gap": 12,
            "valign": "center"
        }
    },

    "search": {
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#3daee9",
                "foreground": "#1b1e20"
            }
        },
        "selected": {
            "font": "fixed",
            "color": {
                "background": "#3daee9",
                "foreground": "#1b1e20"
            }
        },
        "unselected": {
            "font": "fixed",
            "color": {
                "background": "#fcfcfc",
                "foreground": "#1b1e20"
            }
        },
        "border": {
            "color": "#707d8a",
            "width": 2
        }
    },

    "prompt": {
        "label": {
            "font": "fixed bold",
            "color": {
                "background": "#3daee9",
                "foreground": "#1b1e20"
            }
        },
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#fcfcfc",
                "foreground": "#1b1e20"
            }
        },
        "border": {
            "color": "#707d8a",
            "width": 2
        }
    },

    "scratchpad": {
        "border": {
            "color": "#1b1e20",
            "width": 2
        }
    },

    "xsettings": {
        "dpi": 96,
        "is-enabled": false,
        "theme": {
            "gtk-theme-name": "Adwaita",
            "icon-theme-name": "Adwaita",
            "cursor-theme-name": "Adwaita",
            "cursor-theme-size": 24
        }
    }
}
