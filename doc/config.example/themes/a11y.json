{
    "name": "Accessibility theme",

    "-author": "J. A. Corbal",
    "-creation-date": "Fri Aug 14 13:31:13 UTC 2026",
    "-modified-date": "Fri Aug 14 13:31:13 UTC 2026",
    "-notes": "Blue/orange palette (safe for red-green color blindness, the most common kind) with every foreground/background pair checked against WCAG contrast ratios: AA (4.5:1) or better throughout, most pairs AAA (7:1) or better.",

    "desktop": {
        "color": {
            "background": "#3a3a3a"
        }
    },

    "window": {
        "is-decorated": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#4d2400",
                "width": 2
            },
            "color": {
                "background": "#e8a33d",
                "foreground": "#1a1000"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "border": {
                "color": "#1c4e80",
                "width": 2
            },
            "color": {
                "background": "#c8d8e8",
                "foreground": "#0d1b2a"
            },
            "font": "fixed"
        },
        "titlebar": {
            "alignment": "center",
            "buttons": {
                "color": {
                    "off": "#1c4e80",
                    "on": "#4d2400"
                },
                "left": [ "pin", "layer" ],
                "right": [ "close", "maximize", "shade", "iconize" ]
            },
            "height": 22,
            "padding": {
                "horizontal": 2,
                "vertical": 2
            }
        }
    },

    "icon": {
        "is-captioned": true,
        "show-hints": true,
        "show-pixmaps": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#4d2400",
                "width": 1
            },
            "color": {
                "background": "#e8a33d",
                "foreground": "#1a1000"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "opacity": 100,
            "border": {
                "color": "#1c4e80",
                "width": 1
            },
            "color": {
                "background": "#c8d8e8",
                "foreground": "#0d1b2a"
            },
            "font": "fixed"
        }
    },

    "menu": {
        "opacity": 100,
        "show-pixmaps": true,
        "border": {
            "color": "#1c4e80",
            "width": 2
        },
        "disabled": {
            "color": {
                "foreground": "#5a5a5a"
            }
        },
        "label": {
            "border": {
                "color": "#1c4e80",
                "width": 0
            },
            "color": {
                "background": "#3a3a3a",
                "foreground": "#f2f2f2"
            },
            "font": "fixed"
        },
        "padding": {
            "horizontal": 12,
            "vertical": 4
        },
        "selected": {
            "border": {
                "color": "#4d2400",
                "width": 0
            },
            "color": {
                "background": "#e8a33d",
                "foreground": "#1a1000"
            },
            "font": "fixed"
        },
        "separator": {
            "color": "#1c4e80"
        },
        "unselected": {
            "border": {
                "color": "#1c4e80",
                "width": 0
            },
            "color": {
                "background": "#f2f2f2",
                "foreground": "#1a1a1a"
            },
            "font": "fixed"
        }
    },

    "dialog": {
        "opacity": 100,
        "border": {
            "color": "#1c4e80",
            "width": 2
        },
        "button": {
            "gap": 24,
            "padding": {
                "horizontal": 12,
                "vertical": 6
            },
            "selected": {
                "border": {
                    "color": "#4d2400",
                    "width": 1
                },
                "color": {
                    "background": "#e8a33d",
                    "foreground": "#1a1000"
                },
                "font": "fixed bold"
            },
            "unselected": {
                "border": {
                    "color": "#1c4e80",
                    "width": 1
                },
                "color": {
                    "background": "#f2f2f2",
                    "foreground": "#1a1a1a"
                },
                "font": "fixed"
            }
        },
        "color": {
            "background": "#f2f2f2"
        },
        "label": {
            "color": {
                "foreground": "#1a1a1a"
            },
            "font": "fixed bold",
            "padding": {
                "horizontal": 12,
                "vertical": 12
            }
        }
    },

    "overlay": {
        "opacity": 100,
        "font": "fixed",
        "border": {
            "color": "#1c4e80",
            "width": 1
        },
        "color": {
            "background": "#c8d8e8",
            "foreground": "#0d1b2a"
        }
    },

    "systray": {
        "opacity": 100,
        "font": "fixed bold",
        "height": 22,
        "border": {
            "color": "#1c4e80",
            "width": 1
        },
        "color": {
            "background": "#c8d8e8",
            "foreground": "#0d1b2a"
        },
        "pixmap": {
            "size": 24,
            "padding": 2
        },
        "text": {
            "gap": 12,
            "valign": "center"
        }

    },

    "scratchpad": {
        "border": {
            "color": "#4d2400",
            "width": 2
        }
    },

    "xsettings": {
        "dpi": 96,
        "is-enabled": false,
        "theme": {
            "gtk-theme-name": "Adwaita",
            "icon-theme-name": "Adwaita",
            "cursor-theme-name": "Adwaita",
            "cursor-theme-size": 24
        }
    }
}
