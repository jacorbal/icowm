{
    "name": "Gruvbox (light)",

    "-author": "J. A. Corbal",
    "-creation-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-modified-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-notes": "Pavel Pertsev's Gruvbox, light variant, official values only.  Text Lc 70 and 5.6:1 or better, dimmed elements Lc 57, window frames 3.2:1 on the desktop.",

    "desktop": {
        "color": {
            "background": "#fbf1c7"
        }
    },

    "cycle": {
        "border": {
            "color": "#d65d0e",
            "width": 4
        }
    },

    "window": {
        "is-decorated": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#af3a03",
                "width": 2
            },
            "color": {
                "background": "#af3a03",
                "foreground": "#f9f5d7"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "border": {
                "color": "#928374",
                "width": 2
            },
            "color": {
                "background": "#ebdbb2",
                "foreground": "#1d2021"
            },
            "font": "fixed"
        },
        "titlebar": {
            "alignment": "center",
            "buttons": {
                "color": {
                    "off": "#665c54",
                    "on": "#f9f5d7"
                },
                "left": [ "pin", "layer" ],
                "right": [ "close", "maximize", "shade", "iconize" ]
            },
            "height": 22,
            "padding": {
                "horizontal": 2,
                "vertical": 2
            }
        }
    },

    "icon": {
        "is-captioned": true,
        "show-hints": true,
        "show-pixmaps": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#af3a03",
                "width": 1
            },
            "color": {
                "background": "#af3a03",
                "foreground": "#f9f5d7"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "opacity": 100,
            "border": {
                "color": "#928374",
                "width": 1
            },
            "color": {
                "background": "#ebdbb2",
                "foreground": "#1d2021"
            },
            "font": "fixed"
        }
    },

    "menu": {
        "opacity": 100,
        "show-pixmaps": true,
        "border": {
            "color": "#7c6f64",
            "width": 2
        },
        "disabled": {
            "color": {
                "foreground": "#504945"
            }
        },
        "label": {
            "border": {
                "color": "#7c6f64",
                "width": 0
            },
            "color": {
                "background": "#d5c4a1",
                "foreground": "#1d2021"
            },
            "font": "fixed"
        },
        "padding": {
            "horizontal": 12,
            "vertical": 4
        },
        "selected": {
            "border": {
                "color": "#af3a03",
                "width": 0
            },
            "color": {
                "background": "#af3a03",
                "foreground": "#f9f5d7"
            },
            "font": "fixed"
        },
        "separator": {
            "color": "#7c6f64"
        },
        "unselected": {
            "border": {
                "color": "#7c6f64",
                "width": 0
            },
            "color": {
                "background": "#ebdbb2",
                "foreground": "#1d2021"
            },
            "font": "fixed"
        }
    },

    "dialog": {
        "opacity": 100,
        "border": {
            "color": "#7c6f64",
            "width": 2
        },
        "button": {
            "gap": 24,
            "padding": {
                "horizontal": 12,
                "vertical": 6
            },
            "selected": {
                "border": {
                    "color": "#af3a03",
                    "width": 1
                },
                "color": {
                    "background": "#af3a03",
                    "foreground": "#f9f5d7"
                },
                "font": "fixed bold"
            },
            "unselected": {
                "border": {
                    "color": "#7c6f64",
                    "width": 1
                },
                "color": {
                    "background": "#ebdbb2",
                    "foreground": "#1d2021"
                },
                "font": "fixed"
            }
        },
        "color": {
            "background": "#ebdbb2"
        },
        "label": {
            "color": {
                "foreground": "#1d2021"
            },
            "font": "fixed bold",
            "padding": {
                "horizontal": 12,
                "vertical": 12
            }
        }
    },

    "overlay": {
        "opacity": 100,
        "font": "fixed",
        "border": {
            "color": "#7c6f64",
            "width": 1
        },
        "color": {
            "background": "#ebdbb2",
            "foreground": "#1d2021"
        }
    },

    "systray": {
        "opacity": 100,
        "font": "fixed bold",
        "height": 22,
        "border": {
            "color": "#7c6f64",
            "width": 1
        },
        "color": {
            "background": "#ebdbb2",
            "foreground": "#1d2021"
        },
        "pixmap": {
            "size": 24,
            "padding": 2
        },
        "text": {
            "gap": 12,
            "valign": "center"
        }
    },

    "search": {
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#af3a03",
                "foreground": "#f9f5d7"
            }
        },
        "selected": {
            "font": "fixed",
            "color": {
                "background": "#af3a03",
                "foreground": "#f9f5d7"
            }
        },
        "unselected": {
            "font": "fixed",
            "color": {
                "background": "#ebdbb2",
                "foreground": "#1d2021"
            }
        },
        "border": {
            "color": "#7c6f64",
            "width": 2
        }
    },

    "prompt": {
        "label": {
            "font": "fixed bold",
            "color": {
                "background": "#af3a03",
                "foreground": "#f9f5d7"
            }
        },
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#ebdbb2",
                "foreground": "#1d2021"
            }
        },
        "border": {
            "color": "#7c6f64",
            "width": 2
        }
    },

    "scratchpad": {
        "border": {
            "color": "#af3a03",
            "width": 2
        }
    },

    "xsettings": {
        "dpi": 96,
        "is-enabled": false,
        "theme": {
            "gtk-theme-name": "Adwaita",
            "icon-theme-name": "Adwaita",
            "cursor-theme-name": "Adwaita",
            "cursor-theme-size": 24
        }
    }
}
