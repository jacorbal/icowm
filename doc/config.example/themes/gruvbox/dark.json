{
    "name": "Gruvbox (dark)",

    "-author": "J. A. Corbal",
    "-creation-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-modified-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-notes": "Pavel Pertsev's Gruvbox, dark variant, official values only.  Text Lc 77 and 5.6:1 or better, dimmed elements Lc 52, window frames 3.0:1 on the desktop.",

    "desktop": {
        "color": {
            "background": "#282828"
        }
    },

    "cycle": {
        "border": {
            "color": "#fe8019",
            "width": 4
        }
    },

    "window": {
        "is-decorated": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#f9f5d7",
                "width": 2
            },
            "color": {
                "background": "#af3a03",
                "foreground": "#f9f5d7"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "border": {
                "color": "#7c6f64",
                "width": 2
            },
            "color": {
                "background": "#3c3836",
                "foreground": "#f9f5d7"
            },
            "font": "fixed"
        },
        "titlebar": {
            "alignment": "center",
            "buttons": {
                "size": 12,
                "use-symbols": true,
                "color": {
                    "off": "#bdae93",
                    "on": "#f9f5d7"
                },
                "left": [ "sticky", "pin", "layer" ],
                "right": [ "close", "maximize", "shade", "iconize" ]
            },
            "height": 22,
            "padding": {
                "horizontal": 2,
                "vertical": 2
            }
        }
    },

    "icon": {
        "is-captioned": true,
        "show-hints": true,
        "show-pixmaps": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#f9f5d7",
                "width": 1
            },
            "color": {
                "background": "#af3a03",
                "foreground": "#f9f5d7"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "opacity": 100,
            "border": {
                "color": "#7c6f64",
                "width": 1
            },
            "color": {
                "background": "#3c3836",
                "foreground": "#f9f5d7"
            },
            "font": "fixed"
        }
    },

    "menu": {
        "opacity": 100,
        "show-pixmaps": true,
        "border": {
            "color": "#928374",
            "width": 2
        },
        "disabled": {
            "color": {
                "foreground": "#d5c4a1"
            }
        },
        "label": {
            "border": {
                "color": "#928374",
                "width": 0
            },
            "color": {
                "background": "#504945",
                "foreground": "#f9f5d7"
            },
            "font": "fixed"
        },
        "padding": {
            "horizontal": 12,
            "vertical": 4
        },
        "selected": {
            "border": {
                "color": "#f9f5d7",
                "width": 0
            },
            "color": {
                "background": "#af3a03",
                "foreground": "#f9f5d7"
            },
            "font": "fixed"
        },
        "separator": {
            "color": "#928374"
        },
        "unselected": {
            "border": {
                "color": "#928374",
                "width": 0
            },
            "color": {
                "background": "#3c3836",
                "foreground": "#f9f5d7"
            },
            "font": "fixed"
        }
    },

    "dialog": {
        "opacity": 100,
        "border": {
            "color": "#928374",
            "width": 2
        },
        "button": {
            "gap": 24,
            "padding": {
                "horizontal": 12,
                "vertical": 6
            },
            "selected": {
                "border": {
                    "color": "#f9f5d7",
                    "width": 1
                },
                "color": {
                    "background": "#af3a03",
                    "foreground": "#f9f5d7"
                },
                "font": "fixed bold"
            },
            "unselected": {
                "border": {
                    "color": "#928374",
                    "width": 1
                },
                "color": {
                    "background": "#3c3836",
                    "foreground": "#f9f5d7"
                },
                "font": "fixed"
            }
        },
        "color": {
            "background": "#3c3836"
        },
        "label": {
            "color": {
                "foreground": "#f9f5d7"
            },
            "font": "fixed bold",
            "padding": {
                "horizontal": 12,
                "vertical": 12
            }
        }
    },

    "overlay": {
        "opacity": 100,
        "font": "fixed",
        "border": {
            "color": "#928374",
            "width": 1
        },
        "color": {
            "background": "#3c3836",
            "foreground": "#f9f5d7"
        }
    },

    "systray": {
        "opacity": 100,
        "font": "fixed bold",
        "height": 22,
        "border": {
            "color": "#928374",
            "width": 1
        },
        "color": {
            "background": "#3c3836",
            "foreground": "#f9f5d7"
        },
        "pixmap": {
            "size": 24,
            "padding": 2
        },
        "text": {
            "gap": 12,
            "valign": "center"
        }
    },

    "search": {
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#af3a03",
                "foreground": "#f9f5d7"
            }
        },
        "selected": {
            "font": "fixed",
            "color": {
                "background": "#af3a03",
                "foreground": "#f9f5d7"
            }
        },
        "unselected": {
            "font": "fixed",
            "color": {
                "background": "#3c3836",
                "foreground": "#f9f5d7"
            }
        },
        "border": {
            "color": "#928374",
            "width": 2
        }
    },

    "prompt": {
        "label": {
            "font": "fixed bold",
            "color": {
                "background": "#af3a03",
                "foreground": "#f9f5d7"
            }
        },
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#3c3836",
                "foreground": "#f9f5d7"
            }
        },
        "border": {
            "color": "#928374",
            "width": 2
        }
    },

    "scratchpad": {
        "border": {
            "color": "#f9f5d7",
            "width": 2
        }
    },

    "xsettings": {
        "dpi": 96,
        "is-enabled": false,
        "theme": {
            "gtk-theme-name": "Adwaita",
            "icon-theme-name": "Adwaita",
            "cursor-theme-name": "Adwaita",
            "cursor-theme-size": 24
        }
    }
}
