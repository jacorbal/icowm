{
    "name": "Selenized (light)",

    "-author": "J. A. Corbal",
    "-creation-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-modified-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-notes": "Jan Warchol's Selenized, light variant, a Solarized relative built around measured contrast; official values.  Text Lc 61 and 4.6:1 or better, dimmed elements Lc 51, window frames 3.1:1 on the desktop.",

    "desktop": {
        "color": {
            "background": "#fbf3db"
        }
    },

    "cycle": {
        "border": {
            "color": "#0072d4",
            "width": 4
        }
    },

    "window": {
        "is-decorated": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#006dce",
                "width": 2
            },
            "color": {
                "background": "#006dce",
                "foreground": "#fbf3db"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "border": {
                "color": "#009c8f",
                "width": 2
            },
            "color": {
                "background": "#ece3cc",
                "foreground": "#3a4d53"
            },
            "font": "fixed"
        },
        "titlebar": {
            "alignment": "center",
            "buttons": {
                "size": 12,
                "use-symbols": true,
                "color": {
                    "off": "#53676d",
                    "on": "#fbf3db"
                },
                "left": [ "sticky", "pin", "layer" ],
                "right": [ "close", "maximize", "shade", "iconize" ]
            },
            "height": 22,
            "padding": {
                "horizontal": 2,
                "vertical": 2
            }
        }
    },

    "icon": {
        "is-captioned": true,
        "show-hints": true,
        "show-pixmaps": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#006dce",
                "width": 1
            },
            "color": {
                "background": "#006dce",
                "foreground": "#fbf3db"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "opacity": 100,
            "border": {
                "color": "#009c8f",
                "width": 1
            },
            "color": {
                "background": "#ece3cc",
                "foreground": "#3a4d53"
            },
            "font": "fixed"
        }
    },

    "menu": {
        "opacity": 100,
        "show-pixmaps": true,
        "border": {
            "color": "#53676d",
            "width": 2
        },
        "disabled": {
            "color": {
                "foreground": "#53676d"
            }
        },
        "label": {
            "border": {
                "color": "#53676d",
                "width": 0
            },
            "color": {
                "background": "#d5cdb6",
                "foreground": "#3a4d53"
            },
            "font": "fixed"
        },
        "padding": {
            "horizontal": 12,
            "vertical": 4
        },
        "selected": {
            "border": {
                "color": "#006dce",
                "width": 0
            },
            "color": {
                "background": "#006dce",
                "foreground": "#fbf3db"
            },
            "font": "fixed"
        },
        "separator": {
            "color": "#53676d"
        },
        "unselected": {
            "border": {
                "color": "#53676d",
                "width": 0
            },
            "color": {
                "background": "#ece3cc",
                "foreground": "#3a4d53"
            },
            "font": "fixed"
        }
    },

    "dialog": {
        "opacity": 100,
        "border": {
            "color": "#53676d",
            "width": 2
        },
        "button": {
            "gap": 24,
            "padding": {
                "horizontal": 12,
                "vertical": 6
            },
            "selected": {
                "border": {
                    "color": "#006dce",
                    "width": 1
                },
                "color": {
                    "background": "#006dce",
                    "foreground": "#fbf3db"
                },
                "font": "fixed bold"
            },
            "unselected": {
                "border": {
                    "color": "#53676d",
                    "width": 1
                },
                "color": {
                    "background": "#ece3cc",
                    "foreground": "#3a4d53"
                },
                "font": "fixed"
            }
        },
        "color": {
            "background": "#ece3cc"
        },
        "label": {
            "color": {
                "foreground": "#3a4d53"
            },
            "font": "fixed bold",
            "padding": {
                "horizontal": 12,
                "vertical": 12
            }
        }
    },

    "overlay": {
        "opacity": 100,
        "font": "fixed",
        "border": {
            "color": "#53676d",
            "width": 1
        },
        "color": {
            "background": "#ece3cc",
            "foreground": "#3a4d53"
        }
    },

    "systray": {
        "opacity": 100,
        "font": "fixed bold",
        "height": 22,
        "border": {
            "color": "#53676d",
            "width": 1
        },
        "color": {
            "background": "#ece3cc",
            "foreground": "#3a4d53"
        },
        "pixmap": {
            "size": 24,
            "padding": 2
        },
        "text": {
            "gap": 12,
            "valign": "center"
        }
    },

    "search": {
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#006dce",
                "foreground": "#fbf3db"
            }
        },
        "selected": {
            "font": "fixed",
            "color": {
                "background": "#006dce",
                "foreground": "#fbf3db"
            }
        },
        "unselected": {
            "font": "fixed",
            "color": {
                "background": "#ece3cc",
                "foreground": "#3a4d53"
            }
        },
        "border": {
            "color": "#53676d",
            "width": 2
        }
    },

    "prompt": {
        "label": {
            "font": "fixed bold",
            "color": {
                "background": "#006dce",
                "foreground": "#fbf3db"
            }
        },
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#ece3cc",
                "foreground": "#3a4d53"
            }
        },
        "border": {
            "color": "#53676d",
            "width": 2
        }
    },

    "scratchpad": {
        "border": {
            "color": "#006dce",
            "width": 2
        }
    },

    "xsettings": {
        "dpi": 96,
        "is-enabled": false,
        "theme": {
            "gtk-theme-name": "Adwaita",
            "icon-theme-name": "Adwaita",
            "cursor-theme-name": "Adwaita",
            "cursor-theme-size": 24
        }
    }
}
