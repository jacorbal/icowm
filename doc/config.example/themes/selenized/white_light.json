{
    "name": "Selenized White (light)",

    "-author": "J. A. Corbal",
    "-creation-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-modified-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-notes": "Jan Warchol's Selenized White, the achromatic high-contrast variant; official values.  Text Lc 73 and 5.3:1 or better, dimmed elements Lc 62, window frames 3.6:1 on the desktop.",

    "desktop": {
        "color": {
            "background": "#ffffff"
        }
    },

    "cycle": {
        "border": {
            "color": "#d6000c",
            "width": 4
        }
    },

    "window": {
        "is-decorated": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#0064e4",
                "width": 2
            },
            "color": {
                "background": "#0064e4",
                "foreground": "#ffffff"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "border": {
                "color": "#878787",
                "width": 2
            },
            "color": {
                "background": "#ebebeb",
                "foreground": "#282828"
            },
            "font": "fixed"
        },
        "titlebar": {
            "alignment": "center",
            "buttons": {
                "color": {
                    "off": "#474747",
                    "on": "#ffffff"
                },
                "left": [ "pin", "layer" ],
                "right": [ "close", "maximize", "shade", "iconize" ]
            },
            "height": 22,
            "padding": {
                "horizontal": 2,
                "vertical": 2
            }
        }
    },

    "icon": {
        "is-captioned": true,
        "show-hints": true,
        "show-pixmaps": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#0064e4",
                "width": 1
            },
            "color": {
                "background": "#0064e4",
                "foreground": "#ffffff"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "opacity": 100,
            "border": {
                "color": "#878787",
                "width": 1
            },
            "color": {
                "background": "#ebebeb",
                "foreground": "#282828"
            },
            "font": "fixed"
        }
    },

    "menu": {
        "opacity": 100,
        "show-pixmaps": true,
        "border": {
            "color": "#878787",
            "width": 2
        },
        "disabled": {
            "color": {
                "foreground": "#474747"
            }
        },
        "label": {
            "border": {
                "color": "#878787",
                "width": 0
            },
            "color": {
                "background": "#cdcdcd",
                "foreground": "#282828"
            },
            "font": "fixed"
        },
        "padding": {
            "horizontal": 12,
            "vertical": 4
        },
        "selected": {
            "border": {
                "color": "#0064e4",
                "width": 0
            },
            "color": {
                "background": "#0064e4",
                "foreground": "#ffffff"
            },
            "font": "fixed"
        },
        "separator": {
            "color": "#878787"
        },
        "unselected": {
            "border": {
                "color": "#878787",
                "width": 0
            },
            "color": {
                "background": "#ebebeb",
                "foreground": "#282828"
            },
            "font": "fixed"
        }
    },

    "dialog": {
        "opacity": 100,
        "border": {
            "color": "#878787",
            "width": 2
        },
        "button": {
            "gap": 24,
            "padding": {
                "horizontal": 12,
                "vertical": 6
            },
            "selected": {
                "border": {
                    "color": "#0064e4",
                    "width": 1
                },
                "color": {
                    "background": "#0064e4",
                    "foreground": "#ffffff"
                },
                "font": "fixed bold"
            },
            "unselected": {
                "border": {
                    "color": "#878787",
                    "width": 1
                },
                "color": {
                    "background": "#ebebeb",
                    "foreground": "#282828"
                },
                "font": "fixed"
            }
        },
        "color": {
            "background": "#ebebeb"
        },
        "label": {
            "color": {
                "foreground": "#282828"
            },
            "font": "fixed bold",
            "padding": {
                "horizontal": 12,
                "vertical": 12
            }
        }
    },

    "overlay": {
        "opacity": 100,
        "font": "fixed",
        "border": {
            "color": "#878787",
            "width": 1
        },
        "color": {
            "background": "#ebebeb",
            "foreground": "#282828"
        }
    },

    "systray": {
        "opacity": 100,
        "font": "fixed bold",
        "height": 22,
        "border": {
            "color": "#878787",
            "width": 1
        },
        "color": {
            "background": "#ebebeb",
            "foreground": "#282828"
        },
        "pixmap": {
            "size": 24,
            "padding": 2
        },
        "text": {
            "gap": 12,
            "valign": "center"
        }
    },

    "search": {
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#0064e4",
                "foreground": "#ffffff"
            }
        },
        "selected": {
            "font": "fixed",
            "color": {
                "background": "#0064e4",
                "foreground": "#ffffff"
            }
        },
        "unselected": {
            "font": "fixed",
            "color": {
                "background": "#ebebeb",
                "foreground": "#282828"
            }
        },
        "border": {
            "color": "#878787",
            "width": 2
        }
    },

    "prompt": {
        "label": {
            "font": "fixed bold",
            "color": {
                "background": "#0064e4",
                "foreground": "#ffffff"
            }
        },
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#ebebeb",
                "foreground": "#282828"
            }
        },
        "border": {
            "color": "#878787",
            "width": 2
        }
    },

    "scratchpad": {
        "border": {
            "color": "#0064e4",
            "width": 2
        }
    },

    "xsettings": {
        "dpi": 96,
        "is-enabled": false,
        "theme": {
            "gtk-theme-name": "Adwaita",
            "icon-theme-name": "Adwaita",
            "cursor-theme-name": "Adwaita",
            "cursor-theme-size": 24
        }
    }
}
