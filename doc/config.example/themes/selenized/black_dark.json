{
    "name": "Selenized Black (dark)",

    "-author": "J. A. Corbal",
    "-creation-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-modified-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-notes": "Jan Warchol's Selenized Black, the achromatic high-contrast variant; official values.  Text Lc 49 and 6.4:1 or better, dimmed elements Lc 49, window frames 4.0:1 on the desktop.",

    "desktop": {
        "color": {
            "background": "#181818"
        }
    },

    "cycle": {
        "border": {
            "color": "#368aeb",
            "width": 4
        }
    },

    "window": {
        "is-decorated": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#4f9cfe",
                "width": 2
            },
            "color": {
                "background": "#4f9cfe",
                "foreground": "#181818"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "border": {
                "color": "#777777",
                "width": 2
            },
            "color": {
                "background": "#252525",
                "foreground": "#dedede"
            },
            "font": "fixed"
        },
        "titlebar": {
            "alignment": "center",
            "buttons": {
                "color": {
                    "off": "#b9b9b9",
                    "on": "#181818"
                },
                "left": [ "pin", "layer" ],
                "right": [ "close", "maximize", "shade", "iconize" ]
            },
            "height": 22,
            "padding": {
                "horizontal": 2,
                "vertical": 2
            }
        }
    },

    "icon": {
        "is-captioned": true,
        "show-hints": true,
        "show-pixmaps": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#4f9cfe",
                "width": 1
            },
            "color": {
                "background": "#4f9cfe",
                "foreground": "#181818"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "opacity": 100,
            "border": {
                "color": "#777777",
                "width": 1
            },
            "color": {
                "background": "#252525",
                "foreground": "#dedede"
            },
            "font": "fixed"
        }
    },

    "menu": {
        "opacity": 100,
        "show-pixmaps": true,
        "border": {
            "color": "#777777",
            "width": 2
        },
        "disabled": {
            "color": {
                "foreground": "#b9b9b9"
            }
        },
        "label": {
            "border": {
                "color": "#777777",
                "width": 0
            },
            "color": {
                "background": "#3b3b3b",
                "foreground": "#dedede"
            },
            "font": "fixed"
        },
        "padding": {
            "horizontal": 12,
            "vertical": 4
        },
        "selected": {
            "border": {
                "color": "#4f9cfe",
                "width": 0
            },
            "color": {
                "background": "#4f9cfe",
                "foreground": "#181818"
            },
            "font": "fixed"
        },
        "separator": {
            "color": "#777777"
        },
        "unselected": {
            "border": {
                "color": "#777777",
                "width": 0
            },
            "color": {
                "background": "#252525",
                "foreground": "#dedede"
            },
            "font": "fixed"
        }
    },

    "dialog": {
        "opacity": 100,
        "border": {
            "color": "#777777",
            "width": 2
        },
        "button": {
            "gap": 24,
            "padding": {
                "horizontal": 12,
                "vertical": 6
            },
            "selected": {
                "border": {
                    "color": "#4f9cfe",
                    "width": 1
                },
                "color": {
                    "background": "#4f9cfe",
                    "foreground": "#181818"
                },
                "font": "fixed bold"
            },
            "unselected": {
                "border": {
                    "color": "#777777",
                    "width": 1
                },
                "color": {
                    "background": "#252525",
                    "foreground": "#dedede"
                },
                "font": "fixed"
            }
        },
        "color": {
            "background": "#252525"
        },
        "label": {
            "color": {
                "foreground": "#dedede"
            },
            "font": "fixed bold",
            "padding": {
                "horizontal": 12,
                "vertical": 12
            }
        }
    },

    "overlay": {
        "opacity": 100,
        "font": "fixed",
        "border": {
            "color": "#777777",
            "width": 1
        },
        "color": {
            "background": "#252525",
            "foreground": "#dedede"
        }
    },

    "systray": {
        "opacity": 100,
        "font": "fixed bold",
        "height": 22,
        "border": {
            "color": "#777777",
            "width": 1
        },
        "color": {
            "background": "#252525",
            "foreground": "#dedede"
        },
        "pixmap": {
            "size": 24,
            "padding": 2
        },
        "text": {
            "gap": 12,
            "valign": "center"
        }
    },

    "search": {
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#4f9cfe",
                "foreground": "#181818"
            }
        },
        "selected": {
            "font": "fixed",
            "color": {
                "background": "#4f9cfe",
                "foreground": "#181818"
            }
        },
        "unselected": {
            "font": "fixed",
            "color": {
                "background": "#252525",
                "foreground": "#dedede"
            }
        },
        "border": {
            "color": "#777777",
            "width": 2
        }
    },

    "prompt": {
        "label": {
            "font": "fixed bold",
            "color": {
                "background": "#4f9cfe",
                "foreground": "#181818"
            }
        },
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#252525",
                "foreground": "#dedede"
            }
        },
        "border": {
            "color": "#777777",
            "width": 2
        }
    },

    "scratchpad": {
        "border": {
            "color": "#4f9cfe",
            "width": 2
        }
    },

    "xsettings": {
        "dpi": 96,
        "is-enabled": false,
        "theme": {
            "gtk-theme-name": "Adwaita",
            "icon-theme-name": "Adwaita",
            "cursor-theme-name": "Adwaita",
            "cursor-theme-size": 24
        }
    }
}
