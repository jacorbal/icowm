{
    "name": "Selenized (dark)",

    "-author": "J. A. Corbal",
    "-creation-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-modified-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-notes": "Jan Warchol's Selenized, dark variant, a Solarized relative built around measured contrast; official values.  Text Lc 45 and 4.6:1 or better, dimmed elements Lc 45, window frames 3.2:1 on the desktop.",

    "desktop": {
        "color": {
            "background": "#103c48"
        }
    },

    "cycle": {
        "border": {
            "color": "#4695f7",
            "width": 4
        }
    },

    "window": {
        "is-decorated": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#58a3ff",
                "width": 2
            },
            "color": {
                "background": "#58a3ff",
                "foreground": "#103c48"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "border": {
                "color": "#72898f",
                "width": 2
            },
            "color": {
                "background": "#184956",
                "foreground": "#cad8d9"
            },
            "font": "fixed"
        },
        "titlebar": {
            "alignment": "center",
            "buttons": {
                "size": 12,
                "use-symbols": true,
                "color": {
                    "off": "#adbcbc",
                    "on": "#103c48"
                },
                "left": [ "sticky", "pin", "layer" ],
                "right": [ "close", "maximize", "shade", "iconize" ]
            },
            "height": 22,
            "padding": {
                "horizontal": 2,
                "vertical": 2
            }
        }
    },

    "icon": {
        "is-captioned": true,
        "show-hints": true,
        "show-pixmaps": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#58a3ff",
                "width": 1
            },
            "color": {
                "background": "#58a3ff",
                "foreground": "#103c48"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "opacity": 100,
            "border": {
                "color": "#72898f",
                "width": 1
            },
            "color": {
                "background": "#184956",
                "foreground": "#cad8d9"
            },
            "font": "fixed"
        }
    },

    "menu": {
        "opacity": 100,
        "show-pixmaps": true,
        "border": {
            "color": "#adbcbc",
            "width": 2
        },
        "disabled": {
            "color": {
                "foreground": "#ebc13d"
            }
        },
        "label": {
            "border": {
                "color": "#adbcbc",
                "width": 0
            },
            "color": {
                "background": "#2d5b69",
                "foreground": "#cad8d9"
            },
            "font": "fixed"
        },
        "padding": {
            "horizontal": 12,
            "vertical": 4
        },
        "selected": {
            "border": {
                "color": "#58a3ff",
                "width": 0
            },
            "color": {
                "background": "#58a3ff",
                "foreground": "#103c48"
            },
            "font": "fixed"
        },
        "separator": {
            "color": "#adbcbc"
        },
        "unselected": {
            "border": {
                "color": "#adbcbc",
                "width": 0
            },
            "color": {
                "background": "#184956",
                "foreground": "#cad8d9"
            },
            "font": "fixed"
        }
    },

    "dialog": {
        "opacity": 100,
        "border": {
            "color": "#adbcbc",
            "width": 2
        },
        "button": {
            "gap": 24,
            "padding": {
                "horizontal": 12,
                "vertical": 6
            },
            "selected": {
                "border": {
                    "color": "#58a3ff",
                    "width": 1
                },
                "color": {
                    "background": "#58a3ff",
                    "foreground": "#103c48"
                },
                "font": "fixed bold"
            },
            "unselected": {
                "border": {
                    "color": "#adbcbc",
                    "width": 1
                },
                "color": {
                    "background": "#184956",
                    "foreground": "#cad8d9"
                },
                "font": "fixed"
            }
        },
        "color": {
            "background": "#184956"
        },
        "label": {
            "color": {
                "foreground": "#cad8d9"
            },
            "font": "fixed bold",
            "padding": {
                "horizontal": 12,
                "vertical": 12
            }
        }
    },

    "overlay": {
        "opacity": 100,
        "font": "fixed",
        "border": {
            "color": "#adbcbc",
            "width": 1
        },
        "color": {
            "background": "#184956",
            "foreground": "#cad8d9"
        }
    },

    "systray": {
        "opacity": 100,
        "font": "fixed bold",
        "height": 22,
        "border": {
            "color": "#adbcbc",
            "width": 1
        },
        "color": {
            "background": "#184956",
            "foreground": "#cad8d9"
        },
        "pixmap": {
            "size": 24,
            "padding": 2
        },
        "text": {
            "gap": 12,
            "valign": "center"
        }
    },

    "search": {
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#58a3ff",
                "foreground": "#103c48"
            }
        },
        "selected": {
            "font": "fixed",
            "color": {
                "background": "#58a3ff",
                "foreground": "#103c48"
            }
        },
        "unselected": {
            "font": "fixed",
            "color": {
                "background": "#184956",
                "foreground": "#cad8d9"
            }
        },
        "border": {
            "color": "#adbcbc",
            "width": 2
        }
    },

    "prompt": {
        "label": {
            "font": "fixed bold",
            "color": {
                "background": "#58a3ff",
                "foreground": "#103c48"
            }
        },
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#184956",
                "foreground": "#cad8d9"
            }
        },
        "border": {
            "color": "#adbcbc",
            "width": 2
        }
    },

    "scratchpad": {
        "border": {
            "color": "#58a3ff",
            "width": 2
        }
    },

    "xsettings": {
        "dpi": 96,
        "is-enabled": false,
        "theme": {
            "gtk-theme-name": "Adwaita",
            "icon-theme-name": "Adwaita",
            "cursor-theme-name": "Adwaita",
            "cursor-theme-size": 24
        }
    }
}
