{
    "name": "Plum light",
    "-author": "J. A. Corbal",
    "-creation-date": "Tue Aug 25 21:21:00 UTC 2026",
    "-modified-date": "Tue Aug 25 21:21:00 UTC 2026",
    "-notes": "Muted purple with an amber accent; the amber cycling frame carries a long way over it.  Text 9.5:1 on active and 8.6:1 on inactive, window frames 4.4:1 and the cycling frame 3.6:1 on the desktop.",
    "desktop": {
        "color": {
            "background": "#8E7A93"
        }
    },
    "cycle": {
        "border": {
            "color": "#45210A",
            "width": 4
        }
    },
    "window": {
        "is-decorated": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#241629",
                "width": 2
            },
            "color": {
                "background": "#D6BFDB",
                "foreground": "#2A1B2E"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "border": {
                "color": "#63526A",
                "width": 2
            },
            "color": {
                "background": "#EFE6F1",
                "foreground": "#4A3A4E"
            },
            "font": "fixed"
        },
        "titlebar": {
            "alignment": "center",
            "buttons": {
                "size": 12,
                "use-symbols": true,
                "color": {
                    "off": "#63526A",
