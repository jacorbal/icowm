{
    "name": "High contrast dark theme",
    "-author": "J. A. Corbal",
    "-creation-date": "Fri Aug 14 00:00:00 UTC 2026",
    "-modified-date": "Fri Aug 14 00:00:00 UTC 2026",
    "-notes": "Active window inverted to solid yellow-on-black to stand out sharply against an otherwise near-black palette; every pair AA or better (most AAA).",

    "desktop": {
        "color": {
            "background": "#000000"
        }
    },

    "window": {
        "is-decorated": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#ffff00",
                "width": 3
            },
            "color": {
                "background": "#ffff00",
                "foreground": "#000000"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "border": {
                "color": "#a0a0a0",
                "width": 3
            },
            "color": {
                "background": "#1a1a1a",
                "foreground": "#e0e0e0"
            },
            "font": "fixed"
        },
        "titlebar": {
            "alignment": "center",
            "buttons": {
                "color": {
                    "off": "#a0a0a0",
                    "on": "#000000"
                },
                "left": [ "pin", "layer" ],
                "right": [ "close", "maximize", "shade", "iconize" ]
            },
            "height": 22,
            "padding": {
                "horizontal": 2,
                "vertical": 2
            }
        }
    },

    "icon": {
        "is-captioned": true,
        "show-hints": true,
        "show-pixmaps": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#ffff00",
                "width": 2
            },
            "color": {
                "background": "#ffff00",
                "foreground": "#000000"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "opacity": 100,
            "border": {
                "color": "#a0a0a0",
                "width": 2
            },
            "color": {
                "background": "#1a1a1a",
                "foreground": "#e0e0e0"
            },
            "font": "fixed"
        }
    },

    "menu": {
        "opacity": 100,
        "show-pixmaps": true,
        "border": {
            "color": "#a0a0a0",
            "width": 2
        },
        "disabled": {
            "color": {
                "foreground": "#808080"
            }
        },
        "label": {
            "border": {
                "color": "#a0a0a0",
                "width": 0
            },
            "color": {
                "background": "#000000",
                "foreground": "#e0e0e0"
            },
            "font": "fixed"
        },
        "padding": {
            "horizontal": 12,
            "vertical": 4
        },
        "selected": {
            "border": {
                "color": "#000000",
                "width": 0
            },
            "color": {
                "background": "#ffff00",
                "foreground": "#000000"
            },
            "font": "fixed"
        },
        "separator": {
            "color": "#a0a0a0"
        },
        "unselected": {
            "border": {
                "color": "#a0a0a0",
                "width": 0
            },
            "color": {
                "background": "#1a1a1a",
                "foreground": "#e0e0e0"
            },
            "font": "fixed"
        }
    },

    "dialog": {
        "opacity": 100,
        "border": {
            "color": "#a0a0a0",
            "width": 3
        },
        "button": {
            "gap": 24,
            "padding": {
                "horizontal": 12,
                "vertical": 6
            },
            "selected": {
                "border": {
                    "color": "#000000",
                    "width": 2
                },
                "color": {
                    "background": "#ffff00",
                    "foreground": "#000000"
                },
                "font": "fixed bold"
            },
            "unselected": {
                "border": {
                    "color": "#a0a0a0",
                    "width": 2
                },
                "color": {
                    "background": "#1a1a1a",
                    "foreground": "#e0e0e0"
                },
                "font": "fixed"
            }
        },
        "color": {
            "background": "#1a1a1a"
        },
        "label": {
            "color": {
                "foreground": "#e0e0e0"
            },
            "font": "fixed bold",
            "padding": {
                "horizontal": 12,
                "vertical": 12
            }
        }
    },

    "overlay": {
        "opacity": 100,
        "font": "fixed",
        "border": {
            "color": "#a0a0a0",
            "width": 2
        },
        "color": {
            "background": "#1a1a1a",
            "foreground": "#e0e0e0"
        }
    },

    "systray": {
        "opacity": 100,
        "font": "fixed bold",
        "height": 22,
        "border": {
            "color": "#a0a0a0",
            "width": 2
        },
        "color": {
            "background": "#1a1a1a",
            "foreground": "#e0e0e0"
        },
        "pixmap": {
            "size": 24,
            "padding": 2
        },
        "text": {
            "gap": 12,
            "valign": "center"
        }

    },

    "scratchpad": {
        "border": {
            "color": "#ffff00",
            "width": 3
        }
    },

    "xsettings": {
        "dpi": 96,
        "is-enabled": false,
        "theme": {
            "gtk-theme-name": "Adwaita",
            "icon-theme-name": "Adwaita",
            "cursor-theme-name": "Adwaita",
            "cursor-theme-size": 24
        }
    }
}
