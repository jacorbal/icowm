{
    "name": "Indigo light",
    "-author": "J. A. Corbal",
    "-creation-date": "Tue Aug 25 21:21:00 UTC 2026",
    "-modified-date": "Tue Aug 25 21:21:00 UTC 2026",
    "-notes": "A deeper, bluer blue than the built-in theme's slate, with a warm ochre cycling frame against it.  Text 9.4:1 on active and 8.3:1 on inactive, window frames 4.5:1 and the cycling frame 4.2:1 on the desktop.",

    "desktop": {
        "color": {
            "background": "#7C87B8"
        }
    },

    "cycle": {
        "border": {
            "color": "#42200A",
            "width": 4
        }
    },
    
    "window": {
        "is-decorated": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#1B2145",
                "width": 2
            },
            "color": {
                "background": "#BFC7EA",
                "foreground": "#1A2044"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "border": {
                "color": "#525A80",
                "width": 2
            },
            "color": {
                "background": "#E8EBF7",
                "foreground": "#39406B"
            },
            "font": "fixed"
        },
        "titlebar": {
            "alignment": "center",
            "buttons": {
                "size": 12,
                "use-symbols": true,
                "color": {
                    "off": "#525A80",
                    "on": "#1A2044"
                },
                "left": [ "sticky", "pin" ],
                "right": [ "close", "maximize", "shade", "iconize" ]
            },
            "height": 22,
            "padding": {
                "horizontal": 2,
                "vertical": 2
            }
        }
    },
    
    "icon": {
        "is-captioned": true,
        "show-hints": true,
        "show-pixmaps": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#1B2145",
                "width": 1
            },
            "color": {
                "background": "#BFC7EA",
                "foreground": "#1A2044"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "opacity": 100,
            "border": {
                "color": "#525A80",
                "width": 1
            },
            "color": {
                "background": "#E8EBF7",
                "foreground": "#39406B"
            },
            "font": "fixed"
        }
    },
    
    "menu": {
        "opacity": 100,
        "show-pixmaps": true,
        "border": {
            "color": "#525A80",
            "width": 2
        },
        "disabled": {
            "color": {
                "foreground": "#666D96"
            }
        },
        "label": {
            "border": {
                "color": "#525A80",
                "width": 0
            },
            "color": {
                "background": "#BFC7EA",
                "foreground": "#1A2044"
            },
            "font": "fixed bold"
        },
        "padding": {
            "horizontal": 12,
            "vertical": 4
        },
        "selected": {
            "border": {
                "color": "#1B2145",
                "width": 0
            },
            "color": {
                "background": "#BFC7EA",
                "foreground": "#1A2044"
            },
            "font": "fixed"
        },
        "separator": {
            "color": "#525A80"
        },
        "unselected": {
            "border": {
                "color": "#525A80",
                "width": 0
            },
            "color": {
                "background": "#E8EBF7",
                "foreground": "#39406B"
            },
            "font": "fixed"
        }
    },
    
    "dialog": {
        "opacity": 100,
        "border": {
            "color": "#525A80",
            "width": 2
        },
        "button": {
            "gap": 24,
            "padding": {
                "horizontal": 12,
                "vertical": 6
            },
            "selected": {
                "border": {
                    "color": "#1B2145",
                    "width": 1
                },
                "color": {
                    "background": "#BFC7EA",
                    "foreground": "#1A2044"
                },
                "font": "fixed bold"
            },
            "unselected": {
                "border": {
                    "color": "#525A80",
                    "width": 1
                },
                "color": {
                    "background": "#E8EBF7",
                    "foreground": "#39406B"
                },
                "font": "fixed"
            }
        },
        "color": {
            "background": "#E8EBF7"
        },
        "label": {
            "color": {
                "foreground": "#39406B"
            },
            "font": "fixed bold",
            "padding": {
                "horizontal": 12,
                "vertical": 12
            }
        }
    },

    "overlay": {
        "opacity": 100,
        "font": "fixed",
        "border": {
            "color": "#525A80",
            "width": 1
        },
        "color": {
            "background": "#E8EBF7",
            "foreground": "#39406B"
        }
    },
    
    "systray": {
        "opacity": 100,
        "font": "fixed bold",
        "height": 24,
        "border": {
            "color": "#525A80",
            "width": 1
        },
        "color": {
            "background": "#E8EBF7",
            "foreground": "#39406B"
        },
        "pixmap": {
            "size": 24,
            "padding": 2
        },
        "text": {
            "gap": 12,
            "valign": "center"
        }
    },
    
    "search": {
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#BFC7EA",
                "foreground": "#1A2044"
            }
        },
        "selected": {
            "font": "fixed",
            "color": {
                "background": "#BFC7EA",
                "foreground": "#1A2044"
            }
        },
        "unselected": {
            "font": "fixed",
            "color": {
                "background": "#E8EBF7",
                "foreground": "#39406B"
            }
        },
        "border": {
            "color": "#525A80",
            "width": 2
        }
    },

    "prompt": {
        "label": {
            "font": "fixed bold",
            "color": {
                "background": "#BFC7EA",
                "foreground": "#1A2044"
            }
        },
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#E8EBF7",
                "foreground": "#1A2044"
            }
        },
        "border": {
            "color": "#525A80",
            "width": 2
        }
    },

    "scratchpad": {
        "border": {
            "color": "#1B2145",
            "width": 2
        }
    },
    
    "xsettings": {
        "dpi": 96,
        "is-enabled": false,
        "theme": {
            "gtk-theme-name": "Adwaita",
            "icon-theme-name": "Adwaita",
            "cursor-theme-name": "Adwaita",
            "cursor-theme-size": 24
        }
    }
}
