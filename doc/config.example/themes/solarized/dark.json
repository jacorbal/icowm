{
    "name": "Solarized (dark)",

    "-author": "J. A. Corbal",
    "-creation-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-modified-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-notes": "Ethan Schoonover's Solarized, dark variant, official values only.  Text Lc 88 and 12.1:1 or better, dimmed elements Lc 44, window frames 3.4:1 on the desktop.",

    "desktop": {
        "color": {
            "background": "#002b36"
        }
    },

    "cycle": {
        "border": {
            "color": "#b58900",
            "width": 4
        }
    },

    "window": {
        "is-decorated": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#eee8d5",
                "width": 2
            },
            "color": {
                "background": "#eee8d5",
                "foreground": "#002b36"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "border": {
                "color": "#657b83",
                "width": 2
            },
            "color": {
                "background": "#073642",
                "foreground": "#fdf6e3"
            },
            "font": "fixed"
        },
        "titlebar": {
            "alignment": "center",
            "buttons": {
                "size": 12,
                "use-symbols": true,
                "color": {
                    "off": "#93a1a1",
                    "on": "#002b36"
                },
                "left": [ "sticky", "pin" ],
                "right": [ "close", "maximize", "shade", "iconize" ]
            },
            "height": 22,
            "padding": {
                "horizontal": 2,
                "vertical": 2
            }
        }
    },

    "icon": {
        "is-captioned": true,
        "show-hints": true,
        "show-pixmaps": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#eee8d5",
                "width": 1
            },
            "color": {
                "background": "#eee8d5",
                "foreground": "#002b36"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "opacity": 100,
            "border": {
                "color": "#657b83",
                "width": 1
            },
            "color": {
                "background": "#073642",
                "foreground": "#fdf6e3"
            },
            "font": "fixed"
        }
    },

    "menu": {
        "opacity": 100,
        "show-pixmaps": true,
        "border": {
            "color": "#839496",
            "width": 2
        },
        "disabled": {
            "color": {
                "foreground": "#93a1a1"
            }
        },
        "label": {
            "border": {
                "color": "#839496",
                "width": 0
            },
            "color": {
                "background": "#002b36",
                "foreground": "#fdf6e3"
            },
            "font": "fixed"
        },
        "padding": {
            "horizontal": 12,
            "vertical": 4
        },
        "selected": {
            "border": {
                "color": "#eee8d5",
                "width": 0
            },
            "color": {
                "background": "#eee8d5",
                "foreground": "#002b36"
            },
            "font": "fixed"
        },
        "separator": {
            "color": "#839496"
        },
        "unselected": {
            "border": {
                "color": "#839496",
                "width": 0
            },
            "color": {
                "background": "#073642",
                "foreground": "#fdf6e3"
            },
            "font": "fixed"
        }
    },

    "dialog": {
        "opacity": 100,
        "border": {
            "color": "#839496",
            "width": 2
        },
        "button": {
            "gap": 24,
            "padding": {
                "horizontal": 12,
                "vertical": 6
            },
            "selected": {
                "border": {
                    "color": "#eee8d5",
                    "width": 1
                },
                "color": {
                    "background": "#eee8d5",
                    "foreground": "#002b36"
                },
                "font": "fixed bold"
            },
            "unselected": {
                "border": {
                    "color": "#839496",
                    "width": 1
                },
                "color": {
                    "background": "#073642",
                    "foreground": "#fdf6e3"
                },
                "font": "fixed"
            }
        },
        "color": {
            "background": "#073642"
        },
        "label": {
            "color": {
                "foreground": "#fdf6e3"
            },
            "font": "fixed bold",
            "padding": {
                "horizontal": 12,
                "vertical": 12
            }
        }
    },

    "overlay": {
        "opacity": 100,
        "font": "fixed",
        "border": {
            "color": "#839496",
            "width": 1
        },
        "color": {
            "background": "#073642",
            "foreground": "#fdf6e3"
        }
    },

    "systray": {
        "opacity": 100,
        "font": "fixed bold",
        "height": 22,
        "border": {
            "color": "#839496",
            "width": 1
        },
        "color": {
            "background": "#073642",
            "foreground": "#fdf6e3"
        },
        "pixmap": {
            "size": 24,
            "padding": 2
        },
        "text": {
            "gap": 12,
            "valign": "center"
        }
    },

    "search": {
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#eee8d5",
                "foreground": "#002b36"
            }
        },
        "selected": {
            "font": "fixed",
            "color": {
                "background": "#eee8d5",
                "foreground": "#002b36"
            }
        },
        "unselected": {
            "font": "fixed",
            "color": {
                "background": "#073642",
                "foreground": "#fdf6e3"
            }
        },
        "border": {
            "color": "#839496",
            "width": 2
        }
    },

    "prompt": {
        "label": {
            "font": "fixed bold",
            "color": {
                "background": "#eee8d5",
                "foreground": "#002b36"
            }
        },
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#073642",
                "foreground": "#fdf6e3"
            }
        },
        "border": {
            "color": "#839496",
            "width": 2
        }
    },

    "scratchpad": {
        "border": {
            "color": "#eee8d5",
            "width": 2
        }
    },

    "xsettings": {
        "dpi": 96,
        "is-enabled": false,
        "theme": {
            "gtk-theme-name": "Adwaita",
            "icon-theme-name": "Adwaita",
            "cursor-theme-name": "Adwaita",
            "cursor-theme-size": 24
        }
    }
}
