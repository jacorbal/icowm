{
    "name": "Gruvbox (dark)",

    "-author": "J. A. Corbal",
    "-creation-date": "Sun Aug 23 00:27:26 UTC 2026",
    "-modified-date": "Sun Aug 23 22:52:00 UTC 2026",
    "-notes": "Pavel Pertsev's Gruvbox palette (dark variant), using the official published values.",

    "desktop": {
        "color": {
            "background": "#282828"
        }
    },

    "cycle": {
        "border": {
            "color": "#fabd2f",
            "width": 4
        }
    },

    "window": {
        "is-decorated": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#d65d0e",
                "width": 2
            },
            "color": {
                "background": "#d65d0e",
                "foreground": "#fbf1c7"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "border": {
                "color": "#504945",
                "width": 2
            },
            "color": {
                "background": "#3c3836",
                "foreground": "#a89984"
            },
            "font": "fixed"
        },
        "titlebar": {
            "alignment": "center",
            "buttons": {
                "color": {
                    "off": "#504945",
                    "on": "#fbf1c7"
                },
                "left": [ "pin", "layer" ],
                "right": [ "close", "maximize", "shade", "iconize" ]
            },
            "height": 22,
            "padding": {
                "horizontal": 2,
                "vertical": 2
            }
        }
    },

    "icon": {
        "is-captioned": true,
        "show-hints": true,
        "show-pixmaps": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#d65d0e",
                "width": 1
            },
            "color": {
                "background": "#d65d0e",
                "foreground": "#fbf1c7"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "opacity": 100,
            "border": {
                "color": "#504945",
                "width": 1
            },
            "color": {
                "background": "#3c3836",
                "foreground": "#a89984"
            },
            "font": "fixed"
        }
    },

    "menu": {
        "opacity": 100,
        "show-pixmaps": true,
        "border": {
            "color": "#504945",
            "width": 2
        },
        "disabled": {
            "color": {
                "foreground": "#665c54"
            }
        },
        "label": {
            "border": {
                "color": "#504945",
                "width": 0
            },
            "color": {
                "background": "#3c3836",
                "foreground": "#d5c4a1"
            },
            "font": "fixed"
        },
        "padding": {
            "horizontal": 12,
            "vertical": 4
        },
        "selected": {
            "border": {
                "color": "#d65d0e",
                "width": 0
            },
            "color": {
                "background": "#d65d0e",
                "foreground": "#fbf1c7"
            },
            "font": "fixed"
        },
        "separator": {
            "color": "#504945"
        },
        "unselected": {
            "border": {
                "color": "#504945",
                "width": 0
            },
            "color": {
                "background": "#3c3836",
                "foreground": "#a89984"
            },
            "font": "fixed"
        }
    },

    "dialog": {
        "opacity": 100,
        "border": {
            "color": "#504945",
            "width": 2
        },
        "button": {
            "gap": 24,
            "padding": {
                "horizontal": 12,
                "vertical": 6
            },
            "selected": {
                "border": {
                    "color": "#d65d0e",
                    "width": 1
                },
                "color": {
                    "background": "#d65d0e",
                    "foreground": "#fbf1c7"
                },
                "font": "fixed bold"
            },
            "unselected": {
                "border": {
                    "color": "#504945",
                    "width": 1
                },
                "color": {
                    "background": "#3c3836",
                    "foreground": "#a89984"
                },
                "font": "fixed"
            }
        },
        "color": {
            "background": "#3c3836"
        },
        "label": {
            "color": {
                "foreground": "#d5c4a1"
            },
            "font": "fixed bold",
            "padding": {
                "horizontal": 12,
                "vertical": 12
            }
        }
    },

    "overlay": {
        "opacity": 100,
        "font": "fixed",
        "border": {
            "color": "#504945",
            "width": 1
        },
        "color": {
            "background": "#3c3836",
            "foreground": "#a89984"
        }
    },

    "systray": {
        "opacity": 100,
        "font": "fixed bold",
        "height": 22,
        "border": {
            "color": "#504945",
            "width": 1
        },
        "color": {
            "background": "#3c3836",
            "foreground": "#a89984"
        },
        "pixmap": {
            "size": 24,
            "padding": 2
        },
        "text": {
            "gap": 12,
            "valign": "center"
        }
    },

    "search": {
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#d65d0e",
                "foreground": "#fbf1c7"
            }
        },
        "selected": {
            "font": "fixed",
            "color": {
                "background": "#d65d0e",
                "foreground": "#fbf1c7"
            }
        },
        "unselected": {
            "font": "fixed",
            "color": {
                "background": "#3c3836",
                "foreground": "#a89984"
            }
        },
        "border": {
            "color": "#504945",
            "width": 2
        }
    },

    "prompt": {
        "label": {
            "font": "fixed bold",
            "color": {
                "background": "#d65d0e",
                "foreground": "#fbf1c7"
            }
        },
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#3c3836",
                "foreground": "#d5c4a1"
            }
        },
        "border": {
            "color": "#504945",
            "width": 2
        }
    },

    "scratchpad": {
        "border": {
            "color": "#d65d0e",
            "width": 2
        }
    },

    "xsettings": {
        "dpi": 96,
        "is-enabled": false,
        "theme": {
            "gtk-theme-name": "Adwaita",
            "icon-theme-name": "Adwaita",
            "cursor-theme-name": "Adwaita",
            "cursor-theme-size": 24
        }
    }
}
