{
    "name": "Tango (light)",

    "-author": "J. A. Corbal",
    "-creation-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-modified-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-notes": "The Tango Desktop Project palette, light variant, official guideline values.  Text Lc 68 and 8.8:1 or better, dimmed elements Lc 60, window frames 3.0:1 on the desktop.",

    "desktop": {
        "color": {
            "background": "#eeeeec"
        }
    },

    "cycle": {
        "border": {
            "color": "#ce5c00",
            "width": 4
        }
    },

    "window": {
        "is-decorated": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#204a87",
                "width": 2
            },
            "color": {
                "background": "#204a87",
                "foreground": "#ffffff"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "border": {
                "color": "#888a85",
                "width": 2
            },
            "color": {
                "background": "#d3d7cf",
                "foreground": "#000000"
            },
            "font": "fixed"
        },
        "titlebar": {
            "alignment": "center",
            "buttons": {
                "size": 12,
                "use-symbols": true,
                "color": {
                    "off": "#555753",
                    "on": "#ffffff"
                },
                "left": [ "sticky", "pin" ],
                "right": [ "close", "maximize", "shade", "iconize" ]
            },
            "height": 22,
            "padding": {
                "horizontal": 2,
                "vertical": 2
            }
        }
    },

    "icon": {
        "is-captioned": true,
        "show-hints": true,
        "show-pixmaps": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#204a87",
                "width": 1
            },
            "color": {
                "background": "#204a87",
                "foreground": "#ffffff"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "opacity": 100,
            "border": {
                "color": "#888a85",
                "width": 1
            },
            "color": {
                "background": "#d3d7cf",
                "foreground": "#000000"
            },
            "font": "fixed"
        }
    },

    "menu": {
        "opacity": 100,
        "show-pixmaps": true,
        "border": {
            "color": "#555753",
            "width": 2
        },
        "disabled": {
            "color": {
                "foreground": "#2e3436"
            }
        },
        "label": {
            "border": {
                "color": "#555753",
                "width": 0
            },
            "color": {
                "background": "#babdb6",
                "foreground": "#000000"
            },
            "font": "fixed"
        },
        "padding": {
            "horizontal": 12,
            "vertical": 4
        },
        "selected": {
            "border": {
                "color": "#204a87",
                "width": 0
            },
            "color": {
                "background": "#204a87",
                "foreground": "#ffffff"
            },
            "font": "fixed"
        },
        "separator": {
            "color": "#555753"
        },
        "unselected": {
            "border": {
                "color": "#555753",
                "width": 0
            },
            "color": {
                "background": "#d3d7cf",
                "foreground": "#000000"
            },
            "font": "fixed"
        }
    },

    "dialog": {
        "opacity": 100,
        "border": {
            "color": "#555753",
            "width": 2
        },
        "button": {
            "gap": 24,
            "padding": {
                "horizontal": 12,
                "vertical": 6
            },
            "selected": {
                "border": {
                    "color": "#204a87",
                    "width": 1
                },
                "color": {
                    "background": "#204a87",
                    "foreground": "#ffffff"
                },
                "font": "fixed bold"
            },
            "unselected": {
                "border": {
                    "color": "#555753",
                    "width": 1
                },
                "color": {
                    "background": "#d3d7cf",
                    "foreground": "#000000"
                },
                "font": "fixed"
            }
        },
        "color": {
            "background": "#d3d7cf"
        },
        "label": {
            "color": {
                "foreground": "#000000"
            },
            "font": "fixed bold",
            "padding": {
                "horizontal": 12,
                "vertical": 12
            }
        }
    },

    "overlay": {
        "opacity": 100,
        "font": "fixed",
        "border": {
            "color": "#555753",
            "width": 1
        },
        "color": {
            "background": "#d3d7cf",
            "foreground": "#000000"
        }
    },

    "systray": {
        "opacity": 100,
        "font": "fixed bold",
        "height": 22,
        "border": {
            "color": "#555753",
            "width": 1
        },
        "color": {
            "background": "#d3d7cf",
            "foreground": "#000000"
        },
        "pixmap": {
            "size": 24,
            "padding": 2
        },
        "text": {
            "gap": 12,
            "valign": "center"
        }
    },

    "search": {
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#204a87",
                "foreground": "#ffffff"
            }
        },
        "selected": {
            "font": "fixed",
            "color": {
                "background": "#204a87",
                "foreground": "#ffffff"
            }
        },
        "unselected": {
            "font": "fixed",
            "color": {
                "background": "#d3d7cf",
                "foreground": "#000000"
            }
        },
        "border": {
            "color": "#555753",
            "width": 2
        }
    },

    "prompt": {
        "label": {
            "font": "fixed bold",
            "color": {
                "background": "#204a87",
                "foreground": "#ffffff"
            }
        },
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#d3d7cf",
                "foreground": "#000000"
            }
        },
        "border": {
            "color": "#555753",
            "width": 2
        }
    },

    "scratchpad": {
        "border": {
            "color": "#204a87",
            "width": 2
        }
    },

    "xsettings": {
        "dpi": 96,
        "is-enabled": false,
        "theme": {
            "gtk-theme-name": "Adwaita",
            "icon-theme-name": "Adwaita",
            "cursor-theme-name": "Adwaita",
            "cursor-theme-size": 24
        }
    }
}
