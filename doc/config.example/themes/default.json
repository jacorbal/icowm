{
    "name": "Default theme",

    "-author": "J. A. Corbal",
    "-creation-date": "Sat Aug  1 03:57:31 UTC 2026",
    "-modified-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-notes": "In-house blue-grey scheme: slate desktop, pale blue-grey window surfaces, a mid-blue active title bar and a warm gold cycling frame.  Text Lc 56 and 7.0:1 or better, dimmed elements Lc 56, window frames 3.0:1 on the desktop.",

    "desktop": {
        "color": {
            "background": "#5f7187"
        }
    },

    "cycle": {
        "border": {
            "color": "#e3c76e",
            "width": 4
        }
    },

    "window": {
        "is-decorated": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#22272f",
                "width": 2
            },
            "color": {
                "background": "#9aaec8",
                "foreground": "#1b222e"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "border": {
                "color": "#1d2732",
                "width": 2
            },
            "color": {
                "background": "#d0d9e5",
                "foreground": "#3a4351"
            },
            "font": "fixed"
        },
        "titlebar": {
            "alignment": "center",
            "buttons": {
                "size": 12,
                "use-symbols": true,
                "color": {
                    "off": "#4e6076",
                    "on": "#142335"
                },
                "left": [ "sticky", "pin" ],
                "right": [ "close", "maximize", "shade", "iconize" ]
            },
            "height": 22,
            "padding": {
                "horizontal": 2,
                "vertical": 2
            }
        }
    },

    "icon": {
        "is-captioned": true,
        "show-hints": true,
        "show-pixmaps": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#22272f",
                "width": 1
            },
            "color": {
                "background": "#9aaec8",
                "foreground": "#1b222e"
            },
            "font": "fixed bold"

        },
        "inactive": {
            "opacity": 100,
            "border": {
                "color": "#1d2732",
                "width": 1
            },
            "color": {
                "background": "#d0d9e5",
                "foreground": "#3a4351"
            },
            "font": "fixed"
        }
    },

    "menu": {
        "opacity": 100,
        "show-pixmaps": true,
        "border": {
            "color": "#4e6076",
            "width": 2
        },
        "disabled": {
            "color": {
                "foreground": "#585f6a"
            }
        },
        "label": {
            "border": {
                "color": "#4e6076",
                "width": 0
            },
            "color": {
                "background": "#9aaec8",
                "foreground": "#1b222e"
            },
            "font": "fixed bold"
        },
        "padding": {
            "horizontal": 12,
            "vertical": 4
        },
        "selected": {
            "border": {
                "color": "#22272f",
                "width": 0
            },
            "color": {
                "background": "#9aaec8",
                "foreground": "#1b222e"
            },
            "font": "fixed"
        },
        "separator": {
            "color": "#4e6076"
        },
        "unselected": {
            "border": {
                "color": "#4e6076",
                "width": 0
            },
            "color": {
                "background": "#d0d9e5",
                "foreground": "#3a4351"
            },
            "font": "fixed"
        }
    },

    "dialog": {
        "opacity": 100,
        "border": {
            "color": "#4e6076",
            "width": 2
        },
        "button": {
            "gap": 24,
            "padding": {
                "horizontal": 12,
                "vertical": 6
            },
            "selected": {
                "border": {
                    "color": "#22272f",
                    "width": 1
                },
                "color": {
                    "background": "#9aaec8",
                    "foreground": "#1b222e"
                },
                "font": "fixed bold"
            },
            "unselected": {
                "border": {
                    "color": "#4e6076",
                    "width": 1
                },
                "color": {
                    "background": "#d0d9e5",
                    "foreground": "#3a4351"
                },
                "font": "fixed"
            }
        },
        "color": {
            "background": "#d0d9e5"
        },
        "label": {
            "color": {
                "foreground": "#3a4351"
            },
            "font": "fixed bold",
            "padding": {
                "horizontal": 12,
                "vertical": 12
            }
        }
    },

    "overlay": {
        "opacity": 100,
        "font": "fixed",
        "border": {
            "color": "#4e6076",
            "width": 1
        },
        "color": {
            "background": "#d0d9e5",
            "foreground": "#3a4351"
        }
    },

    "systray": {
        "opacity": 100,
        "font": "fixed bold",
        "height": 24,
        "border": {
            "color": "#4e6076",
            "width": 1
        },
        "color": {
            "background": "#d0d9e5",
            "foreground": "#3a4351"
        },
        "pixmap": {
            "size": 24,
            "padding": 2
        },
        "text": {
            "gap": 12,
            "valign": "center"
        }
    },

    "search": {
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#9aaec8",
                "foreground": "#1b222e"
            }
        },
        "selected": {
            "font": "fixed",
            "color": {
                "background": "#9aaec8",
                "foreground": "#1b222e"
            }
        },
        "unselected": {
            "font": "fixed",
            "color": {
                "background": "#d0d9e5",
                "foreground": "#3a4351"
            }
        },
        "border": {
            "color": "#4e6076",
            "width": 2
        }
    },

    "prompt": {
        "label": {
            "font": "fixed bold",
            "color": {
                "background": "#9aaec8",
                "foreground": "#1b222e"
            }
        },
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#d0d9e5",
                "foreground": "#1b222e"
            }
        },
        "border": {
            "color": "#4e6076",
            "width": 2
        }
    },

    "scratchpad": {
        "border": {
            "color": "#22272f",
            "width": 2
        }
    },

    "xsettings": {
        "dpi": 96,
        "is-enabled": false,
        "theme": {
            "gtk-theme-name": "Adwaita",
            "icon-theme-name": "Adwaita",
            "cursor-theme-name": "Adwaita",
            "cursor-theme-size": 24
        }
    }
}
