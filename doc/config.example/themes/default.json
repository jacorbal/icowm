{
    "name": "Default theme",
    "author": "J. A. Corbal",
    "creation-date": "Sat Aug  1 03:57:54 UTC 2026",
    "modified-date": "Sat Aug  7 15:08:21 UTC 2026",

    "window": {
        "is-decorated": true,
        "titlebar": {
            "height": 19,
            "alignment": "left",
            "padding": {
                "horizontal": 2,
                "vertical": 2
            },
            "buttons": {
                "left": [ "pin", "layer" ],
                "right": [
                    "iconize",
                    "hide",
                    "shade",
                    "maximize",
                    "fullscreen",
                    "close"
                ]
            }
        },
        "active": {
            "font": "fixed bold",
            "color": {
                "background": "#9aaec8",
                "foreground": "#253040"
            },
            "border": {
                "color": "#4a5566",
                "width": 2
            }
        },
        "inactive": {
            "font": "fixed",
            "color": {
                "background": "#d0d9e5",
                "foreground": "#4a5566"
            },
            "border": {
                "color": "#7f9ab6",
                "width": 2
            }
        }
    },

    "icon": {
        "is-captioned": true,
        "active": {
            "font": "fixed bold",
            "color": {
                "background": "#9aaec8",
                "foreground": "#253040"
            },
            "border": {
                "color": "#4a5566",
                "width": 1
            }
        },
        "inactive": {
            "font": "fixed",
            "color": {
                "background": "#d0d9e5",
                "foreground": "#4a5566"
            },
            "border": {
                "color": "#7f9ab6",
                "width": 1
            }
        }
    },

    "systray": {
        "font": "fixed",
        "color": {
            "background": "#d0d9e5",
            "foreground": "#4a5566"
        },
        "border": {
            "color": "#7f9ab6",
            "width": 1
        },
        "height": 24,
        "clock": {
            "valign": "center"
        }
    },

    "menu": {
        "unselected": {
            "font": "fixed",
            "color": {
                "background": "#d0d9e5",
                "foreground": "#4a5566"
            },
            "border": {
                "color": "#7f9ab6",
                "width": 0
            }
        },
        "selected": {
            "font": "fixed bold",
            "color": {
                "background": "#9aaec8",
                "foreground": "#253040"
            },
            "border": {
                "color": "#4a5566",
                "width": 1
            }
        },
        "label": {
            "font": "fixed",
            "color": {
                "background": "#d0d9e5",
                "foreground": "#7f9ab6"
            },
            "border": {
                "color": "#7f9ab6",
                "width": 0
            }
        },
        "disabled": {
            "color": {
                "foreground": "#a0a8b0"
            }
        },
        "separator": {
            "color": "#7f9ab6"
        }
    },

    "dialog": {
        "color": {
            "background": "#d0d9e5"
        },
        "border": {
            "color": "#7f9ab6",
            "width": 2
        },
        "label": {
            "font": "fixed",
            "color": {
                "foreground": "#4a5566"
            }
        },
        "button": {
            "unselected": {
                "font": "fixed",
                "color": {
                    "background": "#d0d9e5",
                    "foreground": "#4a5566"
                },
                "border": {
                    "color": "#7f9ab6",
                    "width": 1
                }
            },
            "selected": {
                "font": "fixed bold",
                "color": {
                    "background": "#9aaec8",
                    "foreground": "#253040"
                },
                "border": {
                    "color": "#4a5566",
                    "width": 1
                }
            }
        }
    },

    "overlay": {
        "font": "fixed",
        "color": {
            "background": "#d0d9e5",
            "foreground": "#4a5566"
        },
        "border": {
            "color": "#7f9ab6",
            "width": 1
        }
    }
}
