{
    "name": "Adwaita (dark)",

    "-author": "J. A. Corbal",
    "-creation-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-modified-date": "Mon Aug 24 03:30:00 UTC 2026",
    "-notes": "GNOME's Adwaita palette as published in libadwaita, dark variant.  Text Lc 78 and 4.8:1 or better, dimmed elements Lc 60, window frames 3.3:1 on the desktop.",

    "desktop": {
        "color": {
            "background": "#241f31"
        }
    },

    "cycle": {
        "border": {
            "color": "#ff7800",
            "width": 4
        }
    },

    "window": {
        "is-decorated": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#1c71d8",
                "width": 2
            },
            "color": {
                "background": "#1c71d8",
                "foreground": "#ffffff"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "border": {
                "color": "#c64600",
                "width": 2
            },
            "color": {
                "background": "#3d3846",
                "foreground": "#ffffff"
            },
            "font": "fixed"
        },
        "titlebar": {
            "alignment": "center",
            "buttons": {
                "size": 12,
                "use-symbols": true,
                "color": {
                    "off": "#c0bfbc",
                    "on": "#ffffff"
                },
                "left": [ "sticky", "pin", "layer" ],
                "right": [ "close", "maximize", "shade", "iconize" ]
            },
            "height": 22,
            "padding": {
                "horizontal": 2,
                "vertical": 2
            }
        }
    },

    "icon": {
        "is-captioned": true,
        "show-hints": true,
        "show-pixmaps": true,
        "active": {
            "opacity": 100,
            "border": {
                "color": "#1c71d8",
                "width": 1
            },
            "color": {
                "background": "#1c71d8",
                "foreground": "#ffffff"
            },
            "font": "fixed bold"
        },
        "inactive": {
            "opacity": 100,
            "border": {
                "color": "#c64600",
                "width": 1
            },
            "color": {
                "background": "#3d3846",
                "foreground": "#ffffff"
            },
            "font": "fixed"
        }
    },

    "menu": {
        "opacity": 100,
        "show-pixmaps": true,
        "border": {
            "color": "#9a9996",
            "width": 2
        },
        "disabled": {
            "color": {
                "foreground": "#deddda"
            }
        },
        "label": {
            "border": {
                "color": "#9a9996",
                "width": 0
            },
            "color": {
                "background": "#5e5c64",
                "foreground": "#ffffff"
            },
            "font": "fixed"
        },
        "padding": {
            "horizontal": 12,
            "vertical": 4
        },
        "selected": {
            "border": {
                "color": "#1c71d8",
                "width": 0
            },
            "color": {
                "background": "#1c71d8",
                "foreground": "#ffffff"
            },
            "font": "fixed"
        },
        "separator": {
            "color": "#9a9996"
        },
        "unselected": {
            "border": {
                "color": "#9a9996",
                "width": 0
            },
            "color": {
                "background": "#3d3846",
                "foreground": "#ffffff"
            },
            "font": "fixed"
        }
    },

    "dialog": {
        "opacity": 100,
        "border": {
            "color": "#9a9996",
            "width": 2
        },
        "button": {
            "gap": 24,
            "padding": {
                "horizontal": 12,
                "vertical": 6
            },
            "selected": {
                "border": {
                    "color": "#1c71d8",
                    "width": 1
                },
                "color": {
                    "background": "#1c71d8",
                    "foreground": "#ffffff"
                },
                "font": "fixed bold"
            },
            "unselected": {
                "border": {
                    "color": "#9a9996",
                    "width": 1
                },
                "color": {
                    "background": "#3d3846",
                    "foreground": "#ffffff"
                },
                "font": "fixed"
            }
        },
        "color": {
            "background": "#3d3846"
        },
        "label": {
            "color": {
                "foreground": "#ffffff"
            },
            "font": "fixed bold",
            "padding": {
                "horizontal": 12,
                "vertical": 12
            }
        }
    },

    "overlay": {
        "opacity": 100,
        "font": "fixed",
        "border": {
            "color": "#9a9996",
            "width": 1
        },
        "color": {
            "background": "#3d3846",
            "foreground": "#ffffff"
        }
    },

    "systray": {
        "opacity": 100,
        "font": "fixed bold",
        "height": 22,
        "border": {
            "color": "#9a9996",
            "width": 1
        },
        "color": {
            "background": "#3d3846",
            "foreground": "#ffffff"
        },
        "pixmap": {
            "size": 24,
            "padding": 2
        },
        "text": {
            "gap": 12,
            "valign": "center"
        }
    },

    "search": {
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#1c71d8",
                "foreground": "#ffffff"
            }
        },
        "selected": {
            "font": "fixed",
            "color": {
                "background": "#1c71d8",
                "foreground": "#ffffff"
            }
        },
        "unselected": {
            "font": "fixed",
            "color": {
                "background": "#3d3846",
                "foreground": "#ffffff"
            }
        },
        "border": {
            "color": "#9a9996",
            "width": 2
        }
    },

    "prompt": {
        "label": {
            "font": "fixed bold",
            "color": {
                "background": "#1c71d8",
                "foreground": "#ffffff"
            }
        },
        "input": {
            "font": "fixed bold",
            "color": {
                "background": "#3d3846",
                "foreground": "#ffffff"
            }
        },
        "border": {
            "color": "#9a9996",
            "width": 2
        }
    },

    "scratchpad": {
        "border": {
            "color": "#1c71d8",
            "width": 2
        }
    },

    "xsettings": {
        "dpi": 96,
        "is-enabled": false,
        "theme": {
            "gtk-theme-name": "Adwaita",
            "icon-theme-name": "Adwaita",
            "cursor-theme-name": "Adwaita",
            "cursor-theme-size": 24
        }
    }
}
